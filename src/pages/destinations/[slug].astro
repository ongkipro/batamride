---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { destinations, type Destination } from '../../data/destinations';
import { WHATSAPP_DISPLAY, buildWhatsAppDestinationLink } from '../../utils/whatsapp';
import { 
  MapPin, Clock, Star, CheckCircle2, ShieldCheck, Car, 
  ArrowRight, MessageSquare, Compass, Sparkles
} from '@lucide/astro';

export function getStaticPaths() {
  return destinations.map(dest => ({
    params: { slug: dest.id },
    props: { dest }
  }));
}

interface Props {
  dest: Destination;
}

const { dest } = Astro.props;
const otherDestinations = destinations.filter(d => d.id !== dest.id);
const waBookingLink = buildWhatsAppDestinationLink(dest.name);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": dest.name,
  "description": dest.description,
  "image": `https://batamride.com${dest.image}`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Batam",
    "addressRegion": "Kepulauan Riau",
    "addressCountry": "ID"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": dest.rating,
    "reviewCount": dest.reviewsCount.replace(/[^0-9]/g, '') || "100"
  }
};
---

<Layout 
  title={`${dest.name} Batam (Travel Guide & Transport) | BatamRide`}
  description={`Visit ${dest.name} in Batam. ${dest.description} Book private Toyota Innova Zenix charter with dedicated driver.`}
  image={dest.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} slot="head" />

  <Header />

  <main class="bg-slate-50 min-h-screen pb-16">
    
    <!-- Hero Banner with Scenic Image Background -->
    <div class="relative bg-[#051326] text-white py-12 lg:py-16 overflow-hidden border-b border-slate-800">
      
      <div class="absolute inset-0 z-0">
        <img 
          src={dest.image} 
          alt={dest.name} 
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#051326]/95 via-[#051326]/85 to-[#051326]/75"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#051326] via-transparent to-black/30"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10 space-y-4">
        
        <!-- Breadcrumb Navigation -->
        <div>
          <Breadcrumb 
            items={[
              { label: 'Attractions & Travel Guide', href: '/destinations' },
              { label: dest.name }
            ]}
          />
        </div>

        <div class="grid lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-8 space-y-3">
            <span class="text-xs font-extrabold uppercase tracking-wider text-[#D2AD68] block">
              {dest.categoryLabel}
            </span>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
              {dest.name}
            </h1>

            <p class="text-sm sm:text-base text-slate-300 italic max-w-2xl leading-relaxed">
              "{dest.tagline}"
            </p>

            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-300 pt-1">
              <span class="flex items-center gap-1.5">
                <MapPin class="w-4 h-4 text-[#D2AD68]" />
                <span>{dest.location}</span>
              </span>
              <span class="flex items-center gap-1.5">
                <Clock class="w-4 h-4 text-[#D2AD68]" />
                <span>Duration: {dest.suggestedDuration}</span>
              </span>
              <span class="flex items-center gap-1 text-amber-300 font-bold">
                <Star class="w-3.5 h-3.5 fill-current" />
                <span>{dest.rating} ({dest.reviewsCount})</span>
              </span>
            </div>
          </div>

          <!-- Quick Action Card in Hero -->
          <div class="lg:col-span-4 bg-white/10 border border-white/20 p-5 sm:p-6 rounded-2xl backdrop-blur-md text-center space-y-3">
            <div class="space-y-0.5">
              <span class="text-xs text-slate-300 uppercase tracking-wider font-semibold block">
                Private Chauffeured Service
              </span>
              <div class="text-xl font-bold text-white">
                Guaranteed Innova Zenix
              </div>
              <p class="text-xs text-slate-300">
                Driver on standby • Petrol & parking included
              </p>
            </div>

            <a 
              href={waBookingLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BA56] text-slate-950 font-bold py-3.5 px-5 rounded-xl text-sm shadow-md transition-all cursor-pointer select-none"
            >
              <span>Book Transport to {dest.name}</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Main Content Body -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <div class="grid lg:grid-cols-12 gap-8">
        
        <!-- Left 8 Columns: Destination Details -->
        <div class="lg:col-span-8 space-y-6 sm:space-y-8">
          
          <!-- Image Card -->
          <div class="rounded-2xl overflow-hidden shadow-xs border border-slate-200/80 bg-white">
            <img 
              src={dest.image} 
              alt={dest.name} 
              class="w-full h-72 sm:h-96 object-cover"
            />
          </div>

          <!-- Description & Overview -->
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 space-y-4 shadow-xs">
            <h2 class="text-xl font-bold text-[#0B2348] tracking-tight">
              About {dest.name}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {dest.description}
            </p>

            <div class="pt-3 border-t border-slate-100">
              <span class="text-xs font-bold text-slate-900 block mb-2">Key Highlights:</span>
              <div class="grid sm:grid-cols-2 gap-2">
                {dest.highlights.map(h => (
                  <div class="flex items-center gap-2 text-xs text-slate-700">
                    <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Travel Tips for Visiting -->
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 space-y-4 shadow-xs">
            <h3 class="text-lg font-bold text-[#0B2348] tracking-tight">
              Visitor Information & Recommendations
            </h3>

            <div class="grid sm:grid-cols-2 gap-4 text-xs text-slate-600">
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                <strong class="text-slate-900 font-bold block">Best Time to Visit:</strong>
                <p>Morning or late afternoon to avoid midday tropical heat.</p>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                <strong class="text-slate-900 font-bold block">Chauffeur Standby:</strong>
                <p>Your driver waits in the designated parking area while you explore at your own leisure.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right 4 Columns: Booking & Other Destinations -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- Private Ride Booking Card -->
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 space-y-4 shadow-xs">
            <span class="text-xs font-bold text-[#B88A3B] uppercase tracking-wider block">
              Private Charter Option
            </span>
            <h3 class="text-lg font-bold text-[#0B2348]">
              Visit {dest.name} in Private Comfort
            </h3>
            
            <p class="text-xs text-slate-600 leading-relaxed">
              Combine this attraction with nearby dining, shopping, or seaside viewpoints in a single full-day charter.
            </p>

            <div class="space-y-1.5 text-xs text-slate-700 py-2 border-y border-slate-100">
              <div class="flex items-center gap-1.5">
                <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Toyota Innova Zenix 2024</span>
              </div>
              <div class="flex items-center gap-1.5">
                <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Uniformed Professional Driver</span>
              </div>
              <div class="flex items-center gap-1.5">
                <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Zero Upfront Deposit</span>
              </div>
            </div>

            <a 
              href={waBookingLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BA56] text-slate-950 font-bold py-3.5 px-4 rounded-xl text-xs sm:text-sm shadow-sm transition-all cursor-pointer select-none"
            >
              <MessageSquare class="w-4 h-4 fill-current" />
              <span>Inquire via WhatsApp</span>
            </a>

            <div class="text-[11px] text-slate-400 text-center">
              Direct hotline: {WHATSAPP_DISPLAY}
            </div>
          </div>

          <!-- Other Attractions -->
          <div class="bg-white rounded-2xl border border-slate-200/80 p-5 space-y-3 shadow-xs">
            <h4 class="text-xs font-bold text-[#0B2348] uppercase tracking-wider">
              Other Popular Attractions
            </h4>
            
            <div class="space-y-2">
              {otherDestinations.slice(0, 4).map(other => (
                <a href={`/destinations/${other.id}`} class="block p-2.5 rounded-xl hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-200">
                  <div class="font-bold text-xs text-slate-800 hover:text-[#B88A3B]">{other.name}</div>
                  <div class="text-[11px] text-slate-500 flex justify-between mt-0.5">
                    <span>{other.categoryLabel}</span>
                    <span class="text-amber-500 font-semibold flex items-center gap-1">
                      <Star class="w-3 h-3 fill-current" />
                      <span>{other.rating}</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

        </div>

      </div>
    </div>

  </main>

  <Footer />
</Layout>
