---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { destinations } from '../../data/destinations';
import { MapPin, Star, Clock, ArrowRight, ShieldCheck, Compass } from '@lucide/astro';

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Top Batam Tourist Attractions & Destinations",
  "description": "Comprehensive travel guide and private transport destinations in Batam Island for Singapore and Malaysia visitors.",
  "itemListElement": destinations.map((d, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "TouristAttraction",
      "name": d.name,
      "description": d.description,
      "image": `https://batamride.com${d.image}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Batam",
        "addressRegion": "Kepulauan Riau",
        "addressCountry": "ID"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": d.rating,
        "reviewCount": d.reviewsCount.replace(/[^0-9]/g, '') || "100"
      }
    }
  }))
};
---

<Layout 
  title="Top Batam Attractions & Places to Visit (Travel Guide) | BatamRide"
  description="Explore the best places to visit in Batam Island: Barelang Bridge, Grand Batam Mall, Wey Wey Seafood, Maitreya Monastery, Spas, and Ranoh Island with private Innova Zenix transport."
  image="/images/barelang-sunset.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} slot="head" />

  <Header />

  <main class="bg-slate-50 min-h-screen pb-16">
    
    <!-- Page Hero Banner with Background Image -->
    <PageHeader 
      badge="Batam Tourism Directory"
      title="Top Attractions & Places to Visit in Batam"
      subtitle="From breathtaking coastal bridges and authentic seafood kelongs to luxury retail malls and traditional spas: explore Batam in complete comfort."
      breadcrumbItems={[
        { label: 'Attractions & Travel Guide' }
      ]}
      bgImage="/images/ranoh-island.jpg"
    />

    <!-- Catalog Section -->
    <section class="py-12 sm:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
        
        <!-- Category Filter Tabs: Horizontal Scrollable on Mobile -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 sm:justify-center -mx-4 px-4 sm:mx-0 sm:px-0 select-none">
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-semibold bg-[#0B2348] text-white transition-all shrink-0 cursor-pointer shadow-2xs" data-category="all">
            All Attractions
          </button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-all shrink-0 cursor-pointer shadow-2xs" data-category="landmark">
            Landmarks & Heritage
          </button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-all shrink-0 cursor-pointer shadow-2xs" data-category="shopping">
            Shopping & Dining
          </button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-all shrink-0 cursor-pointer shadow-2xs" data-category="seafood">
            Kelong Seafood
          </button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-all shrink-0 cursor-pointer shadow-2xs" data-category="spa">
            Spa & Wellness
          </button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-all shrink-0 cursor-pointer shadow-2xs" data-category="beach">
            Resorts & Islands
          </button>
        </div>

        <!-- Destinations Grid -->
        <div id="destinations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {destinations.map(dest => (
            <div class="dest-card rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between card-hover group" data-category={dest.category}>
              
              <!-- Image Banner with Link -->
              <a href={`/destinations/${dest.id}`} class="block relative h-52 sm:h-56 overflow-hidden bg-slate-900">
                <img 
                  src={dest.image} 
                  alt={dest.name} 
                  class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent"></div>
                
                <div class="absolute top-3 left-3">
                  <span class="px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-bold bg-[#0B2348]/90 text-white border border-white/20">
                    {dest.categoryLabel}
                  </span>
                </div>

                <div class="absolute top-3 right-3 flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/95 text-slate-900 shadow-sm">
                  <Star class="w-3 h-3 fill-current text-amber-500" />
                  <span>{dest.rating}</span>
                  <span class="text-slate-400 font-normal">({dest.reviewsCount})</span>
                </div>

                <div class="absolute bottom-3 left-3 right-3 text-white text-xs font-semibold drop-shadow-sm flex items-center gap-1.5">
                  <MapPin class="w-3.5 h-3.5 text-[#D2AD68] shrink-0" />
                  <span class="truncate">{dest.location}</span>
                </div>
              </a>

              <!-- Body Content -->
              <div class="p-5 sm:p-6 space-y-4 flex-1 flex flex-col justify-between">
                
                <div class="space-y-3">
                  <a href={`/destinations/${dest.id}`} class="block group-hover:text-[#B88A3B] transition-colors">
                    <h3 class="text-lg font-bold text-[#0B2348] group-hover:text-[#B88A3B] transition-colors leading-snug">
                      {dest.name}
                    </h3>
                  </a>
                  
                  <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
                    {dest.description}
                  </p>

                  <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 space-y-1 text-[11px] text-slate-700">
                    <span class="font-bold text-[#B88A3B] uppercase tracking-wider block text-[10px]">Highlights:</span>
                    {dest.highlights.slice(0, 2).map(h => (
                      <div class="flex items-center gap-1.5 text-slate-600 truncate">
                        <span class="w-1 h-1 rounded-full bg-[#B88A3B] shrink-0"></span>
                        <span class="truncate">{h}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Footer Link -->
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-[11px] text-slate-500">Duration: {dest.suggestedDuration}</span>
                  <a 
                    href={`/destinations/${dest.id}`}
                    class="inline-flex items-center gap-1 text-xs font-bold text-[#0B2348] hover:text-[#B88A3B] transition-colors"
                  >
                    <span>View Guide</span>
                    <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                </div>

              </div>

            </div>
          ))}
        </div>

        <!-- Travel Tips Section -->
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 sm:p-10 shadow-xs space-y-5">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#B88A3B] uppercase tracking-wider">Travel Advice</span>
            <h3 class="text-xl sm:text-2xl font-bold text-[#0B2348]">
              Planning Your Batam Sightseeing Itinerary
            </h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 text-xs sm:text-sm text-slate-600">
            <div class="bg-slate-50 border border-slate-100 rounded-xl sm:rounded-2xl p-5 space-y-2">
              <h4 class="font-bold text-[#0B2348] text-sm">Why Private Transport is Essential</h4>
              <p class="leading-relaxed">
                Batam lacks a public mass transit network. Iconic destinations such as Barelang Bridge and southern seafood kelongs are 45 to 60 minutes away from city centers. Having a dedicated Toyota Innova Zenix and driver ensures you never get stranded waiting for ride-hailing cars.
              </p>
            </div>
            <div class="bg-slate-50 border border-slate-100 rounded-xl sm:rounded-2xl p-5 space-y-2">
              <h4 class="font-bold text-[#0B2348] text-sm">Ferry Terminal Recommendations</h4>
              <p class="leading-relaxed">
                For city shopping, Nagoya spas, and live seafood, arrive at Batam Centre or Harbour Bay. For luxury coastal resorts and golf greens, choose Nongsapura. Your BatamRide driver meets you directly at the terminal exit hall.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll('.dest-filter-btn');
  const cards = document.querySelectorAll('.dest-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove('bg-[#0B2348]', 'text-white');
        b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });
      btn.classList.add('bg-[#0B2348]', 'text-white');
      btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

      const cat = btn.getAttribute('data-category');

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (cat === 'all' || cardCat === cat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
