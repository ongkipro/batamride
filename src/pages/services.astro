---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "BatamRide Executive Chauffeur & Private Transport Services",
      "provider": {
        "@type": "LocalBusiness",
        "name": "BatamRide",
        "url": "https://batamride.com/"
      },
      "areaServed": {
        "@type": "City",
        "name": "Batam"
      },
      "description": "Comprehensive corporate transport, private full-day chauffeur, ferry transfers, and golf trip logistics in Batam.",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "BatamRide Transport Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Full-Day Private Chauffeur",
              "description": "Up to 12 hours private vehicle with driver, fuel and parking included."
            },
            "price": "70",
            "priceCurrency": "SGD"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Ferry Terminal Transfer",
              "description": "Meet and greet at Harbour Bay, Batam Centre, or Nongsapura ferry terminals."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Hang Nadim Airport Transfer",
              "description": "Door-to-door executive transfer between BTH Airport and Batam hotels."
            }
          }
        ]
      }
    }
  ]
};
---

<Layout
  title="Executive Transport Services in Batam | BatamRide"
  description="Explore BatamRide's full suite of executive transport services: full-day private chauffeur (S$70/day), ferry terminal pickups, corporate charters, and golf logistics."
  canonical="/services/"
  jsonLd={jsonLd}
>
  <main id="main">
    <!-- Services Hero Banner -->
    <section class="corp-hero">
      <div class="shell corp-hero-grid">
        <div class="corp-hero-content">
          <p class="section-label">Our Capabilities</p>
          <h1>Tailored Ground Logistics for <span>Every Itinerary</span></h1>
          <p class="lede">
            Whether arriving for a strategic business meeting in an industrial park, a 36-hole golf weekend, or an uninterrupted weekend with family, BatamRide provides punctual, dedicated ground transport with zero compromises.
          </p>
          <div class="corp-hero-actions">
            <a class="button button-gold" href="/#booking">Book a Service</a>
            <a class="button button-outline" href="#comparison">Compare vs Taxis</a>
          </div>
        </div>

        <aside class="corp-hero-badge-card">
          <p class="card-heading">Transparent Pricing Guarantee</p>
          <p style="color: rgba(255,255,255,0.85); font-size: 14.5px; line-height: 1.6; margin: 0 0 16px;">
            No hidden mileage counters, no peak surge gouging, and no unplanned stops. Fuel, vehicle, professional chauffeur, and ordinary parking are bundled in one clear quote.
          </p>
          <div class="corp-stat-row">
            <div class="corp-stat-item">
              <strong>S$70</strong>
              <span>Full-Day Chauffeur (12h)</span>
            </div>
            <div class="corp-stat-item">
              <strong>0 Surcharge</strong>
              <span>No Fuel or Parking Add-ons</span>
            </div>
            <div class="corp-stat-item">
              <strong>Free</strong>
              <span>Ferry Delay Adjustments</span>
            </div>
            <div class="corp-stat-item">
              <strong>Multi-Lingual</strong>
              <span>English & Mandarin Drivers</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Services Grid Section -->
    <section class="corp-section bg-white">
      <div class="shell">
        <div class="section-intro-center">
          <p class="section-label">Service Portfolio</p>
          <h2>Professional Chauffeur Solutions</h2>
          <p>
            Choose the service that fits your schedule. Every booking includes a dedicated vehicle exclusively reserved for your party.
          </p>
        </div>

        <div class="services-pro-grid">
          <!-- Service 1: Full-Day Private Chauffeur -->
          <article class="service-pro-card">
            <div class="service-icon-box">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.9 2 11.2 2 11.5V16c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
            </div>
            <h3>Full-Day Private Chauffeur</h3>
            <span class="service-rate">From S$70 / Day (Up to 12 Hours)</span>
            <p>
              Your personal vehicle and uniformed chauffeur on standby for up to 12 hours. Set your own pace with unlimited stops across Batam Island.
            </p>
            <ul class="service-checklist">
              <li><span class="check">✓</span> Flexible custom route & itinerary</li>
              <li><span class="check">✓</span> Fuel & standard parking included</li>
              <li><span class="check">✓</span> English / Mandarin driver on request</li>
              <li><span class="check">✓</span> Hotel pickup and return included</li>
            </ul>
            <a class="button button-gold" style="margin-top: auto;" href="/batam-private-driver/">Learn More & Book</a>
          </article>

          <!-- Service 2: Ferry Terminal Transfers -->
          <article class="service-pro-card">
            <div class="service-icon-box">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-9-4-9 4c0 2.9.94 5.34 2.81 7.76"/><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"/><line x1="12" x2="12" y1="1" y2="5"/></svg>
            </div>
            <h3>Ferry Terminal Transfers</h3>
            <span class="service-rate">Punctual Arrival Gate Meet & Greet</span>
            <p>
              Direct transfer between Batam's major ferry hubs (Harbour Bay, Batam Centre, Nongsapura, Sekupang) and your hotel, villa, or office.
            </p>
            <ul class="service-checklist">
              <li><span class="check">✓</span> Live ferry arrival tracking</li>
              <li><span class="check">✓</span> Chauffeur greeting with name card</li>
              <li><span class="check">✓</span> Full luggage loading assistance</li>
              <li><span class="check">✓</span> Zero wait time upon docking</li>
            </ul>
            <a class="button button-gold" style="margin-top: auto;" href="/batam-ferry-terminal-transfer/">Learn More & Book</a>
          </article>

          <!-- Service 3: Airport Transfers -->
          <article class="service-pro-card">
            <div class="service-icon-box">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
            </div>
            <h3>Airport Transfers (BTH)</h3>
            <span class="service-rate">Hang Nadim International Airport</span>
            <p>
              Seamless airport pickup and drop-off connecting domestic flights from Jakarta, Surabaya, and Medan with Batam resorts and industrial estates.
            </p>
            <ul class="service-checklist">
              <li><span class="check">✓</span> Domestic flight schedule monitoring</li>
              <li><span class="check">✓</span> VIP terminal greeting</li>
              <li><span class="check">✓</span> Express toll road routing</li>
              <li><span class="check">✓</span> Spacious boot for oversized baggage</li>
            </ul>
            <a class="button button-gold" style="margin-top: auto;" href="/batam-airport-transfer/">Learn More & Book</a>
          </article>

          <!-- Service 4: Corporate & Industrial Charters -->
          <article class="service-pro-card">
            <div class="service-icon-box">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h3>Corporate & Industrial Park Charters</h3>
            <span class="service-rate">Panbil, Batamindo, Kabil, Batu Ampar</span>
            <p>
              Dedicated executive transport for business delegations, plant visits, engineering inspections, and government meetings across industrial clusters.
            </p>
            <ul class="service-checklist">
              <li><span class="check">✓</span> Multi-stop business itinerary</li>
              <li><span class="check">✓</span> Official corporate tax invoices (SGD/MYR)</li>
              <li><span class="check">✓</span> Multi-vehicle fleet synchronization</li>
              <li><span class="check">✓</span> Strict corporate confidentiality</li>
            </ul>
            <a class="button button-navy" style="margin-top: auto;" href="/contact/">Enquire Corporate</a>
          </article>

          <!-- Service 5: Golfing & Sports Logistics -->
          <article class="service-pro-card">
            <div class="service-icon-box">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3>Golf Package Logistics</h3>
            <span class="service-rate">Sukajadi, Palm Springs, SouthLinks, Batam Hills</span>
            <p>
              Stress-free ground logistics for golfers. Ample luggage clearance for multiple full golf bags, punctual tee-off drop-offs, and post-game dinner standby.
            </p>
            <ul class="service-checklist">
              <li><span class="check">✓</span> Dedicated golf bag clearance</li>
              <li><span class="check">✓</span> Punctual early morning tee-off pickups</li>
              <li><span class="check">✓</span> Chauffeur standby during your round</li>
              <li><span class="check">✓</span> Post-golf seafood dinner coordination</li>
            </ul>
            <a class="button button-navy" style="margin-top: auto;" href="/#booking">Book Golf Transport</a>
          </article>

          <!-- Service 6: Singapore to Batam Gateway -->
          <article class="service-pro-card">
            <div class="service-icon-box">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3>Singapore to Batam Travel Guide</h3>
            <span class="service-rate">HarbourFront & Tanah Merah Gateway</span>
            <p>
              Comprehensive coordination helping Singapore residents plan ferry departures, immigration clearance, luggage allowances, and onward transport.
            </p>
            <ul class="service-checklist">
              <li><span class="check">✓</span> Terminal selection recommendations</li>
              <li><span class="check">✓</span> BatamFast, Sindo, Majestic ferry sync</li>
              <li><span class="check">✓</span> Singapore WhatsApp booking desk</li>
              <li><span class="check">✓</span> PayNow SGD payment support</li>
            </ul>
            <a class="button button-gold" style="margin-top: auto;" href="/singapore-to-batam/">View Route Guide</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Comparison Table: BatamRide vs Street Taxis vs Ride-Hailing Apps -->
    <section class="corp-section bg-cream" id="comparison">
      <div class="shell">
        <div class="section-intro-center">
          <p class="section-label">Value Comparison</p>
          <h2>Why Discerning Travelers Choose BatamRide</h2>
          <p>
            Compare our corporate private chauffeur service against unpredictable street taxis and local ride-hailing options.
          </p>
        </div>

        <div class="comparison-container">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Service Factor</th>
                <th class="highlight-col">BatamRide Executive Chauffeur</th>
                <th>Street Taxis (Harbour / Port)</th>
                <th>Local App-Hailing (Grab / Gojek)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Vehicle Condition</strong></td>
                <td class="highlight-col">Guaranteed modern Toyota Innova Zenix / Reborn (photo approved)</td>
                <td>Older sedans; condition and cleanliness vary drastically</td>
                <td>Random car assignment; often small compact city hatchbacks</td>
              </tr>
              <tr>
                <td><strong>Smoke Policy</strong></td>
                <td class="highlight-col">Strict 0-Smoke policy guarantee, daily ozone sanitized</td>
                <td>Often smells of heavy cigarette smoke and tobacco</td>
                <td>Unpredictable; driver-dependent smoke smell</td>
              </tr>
              <tr>
                <td><strong>Pricing Structure</strong></td>
                <td class="highlight-col">Fixed S$70/day (12 hours) all-inclusive, zero hidden fees</td>
                <td>Aggressive street bargaining; rates inflate for foreigners</td>
                <td>Per-trip surge pricing during rain and peak ferry arrivals</td>
              </tr>
              <tr>
                <td><strong>Luggage & Golf Bags</strong></td>
                <td class="highlight-col">Cavernous cargo room for 4+ suitcases or multiple golf bags</td>
                <td>Small sedan boots, often filled with spare tires or CNG tanks</td>
                <td>Frequently cancelled if carrying 2+ large suitcases or golf bags</td>
              </tr>
              <tr>
                <td><strong>Driver Standby</strong></td>
                <td class="highlight-col">Your chauffeur stays dedicated with you all day; zero waiting</td>
                <td>Must hail and negotiate a new vehicle at every stop</td>
                <td>Must re-book and wait 15–30 mins at every location</td>
              </tr>
              <tr>
                <td><strong>Payment Convenience</strong></td>
                <td class="highlight-col">PayNow (SGD), Touch ’n Go (MYR), Credit Card, or Cash</td>
                <td>Cash only (IDR); change often not available</td>
                <td>Requires foreign card setup with bank forex surcharges</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- CTA Strip -->
    <section class="cta">
      <div class="shell cta-row">
        <div>
          <h2>Book your private Batam driver today</h2>
          <p>Enjoy executive peace of mind for S$70 per day. No deposit until vehicle photo is confirmed.</p>
        </div>
        <div class="whatsapp">
          <a class="button button-gold" href="/#booking">Reserve Online</a>
          <a class="button button-outline" href="/contact/">Contact Dispatch</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
