---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { packages } from '../../data/packages';
import { ShieldCheck, Clock, MapPin, ArrowRight, CheckCircle2 } from '@lucide/astro';

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Curated Batam Day Tour Packages",
  "description": "Premium 100% private day tour itineraries in Batam Island with dedicated Innova Zenix and driver.",
  "itemListElement": packages.map((pkg, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "TouristTrip",
      "name": pkg.name,
      "description": pkg.tagline,
      "offers": {
        "@type": "Offer",
        "price": pkg.rateSgd.replace(/[^0-9]/g, '') || "95",
        "priceCurrency": "SGD"
      }
    }
  }))
};
---

<Layout 
  title="Curated Batam Day Tour Packages (Private Innova Zenix) | BatamRide"
  description="Explore curated Batam day tours: Barelang Sunset, Nagoya Shopping & Spa, Kelong Seafood, and Nongsa Luxury. 100% private with dedicated chauffeur."
  image="/images/barelang-sunset.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} slot="head" />

  <Header />

  <main class="bg-slate-50 min-h-screen pb-16">
    
    <!-- Page Hero Banner with Background Image -->
    <PageHeader 
      badge="Handcrafted Itineraries"
      title="Curated Batam Day Tour Packages"
      subtitle="Stress-free, 100% private day tours with an executive Toyota Innova Zenix and dedicated chauffeur on standby all day."
      breadcrumbItems={[
        { label: 'Curated Day Tours' }
      ]}
      bgImage="/images/barelang-sunset.webp"
    />

    <!-- Tours Grid Section -->
    <section class="py-12 sm:py-18">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {packages.map(pkg => (
            <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
              
              <!-- Image Banner with Link -->
              <a href={`/tours/${pkg.id}`} class="block relative h-56 sm:h-64 overflow-hidden bg-slate-900">
                <img 
                  src={pkg.image} 
                  alt={pkg.name} 
                  width="600"
                  height="360"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                
                <div class="absolute top-3 left-3 flex items-center gap-2">
                  <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-slate-950/80 text-white backdrop-blur-xs">
                    {pkg.badge}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-md text-[10px] font-semibold bg-white/90 text-slate-900">
                    {pkg.duration}
                  </span>
                </div>

                <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between text-white">
                  <div>
                    <h2 class="text-lg sm:text-xl font-bold tracking-tight text-white group-hover:text-[#D2AD68] transition-colors">
                      {pkg.name}
                    </h2>
                  </div>
                  <div class="text-right shrink-0 bg-black/60 px-2.5 py-1 rounded-lg text-xs font-bold text-[#D2AD68]">
                    {pkg.rateSgd}
                  </div>
                </div>
              </a>

              <!-- Card Body Content -->
              <div class="p-5 sm:p-6 space-y-5 flex-1 flex flex-col justify-between">
                
                <div class="space-y-3.5">
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic">
                    "{pkg.tagline}"
                  </p>

                  <!-- Itinerary Highlights List -->
                  <div class="space-y-2 pt-2 border-t border-slate-100">
                    <span class="text-xs font-bold text-slate-900 block">Itinerary Route:</span>
                    <div class="space-y-1 text-xs text-slate-600">
                      {pkg.itinerary.slice(0, 3).map(step => (
                        <div class="flex items-center gap-2">
                          <span class="text-[10px] font-bold text-[#B88A3B]">{step.time}</span>
                          <span class="text-slate-400">•</span>
                          <span class="truncate">{step.activity}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Footer Link & CTA -->
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs text-slate-500 font-medium">{pkg.rateMyr} • {pkg.rateIdr}</span>
                  <a 
                    href={`/tours/${pkg.id}`}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0B2348] hover:text-[#B88A3B] transition-colors"
                  >
                    <span>View Full Itinerary</span>
                    <ArrowRight class="w-4 h-4" />
                  </a>
                </div>

              </div>

            </div>
          ))}
        </div>

        <!-- Tour Customization Reassurance -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 space-y-3">
          <span class="text-xs font-bold text-[#B88A3B] uppercase tracking-wider block">Customization Available</span>
          <h3 class="text-lg sm:text-xl font-bold text-[#0B2348]">
            Want to Modify Stops or Create a Custom Itinerary?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
            All our tour packages are 100% private. You can customize the itinerary, swap restaurants, or adjust pickup times according to your ferry schedule at zero additional charge.
          </p>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>
