---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact BatamRide Corporate Dispatch & Enquiries",
      "url": "https://batamride.com/contact/",
      "description": "Direct Singapore and Malaysia WhatsApp dispatch desks for BatamRide private driver bookings, corporate charters, and ferry terminal transfers."
    },
    {
      "@type": "LocalBusiness",
      "name": "BatamRide Dispatch Centre",
      "telephone": ["+6580900928", "+60189028790"],
      "openingHours": "Mo-Su 06:00-23:00",
      "url": "https://batamride.com/"
    }
  ]
};
---

<Layout
  title="Contact & Dispatch | Singapore & Malaysia Desks | BatamRide"
  description="Connect with BatamRide's cross-border dispatch desks. Instant WhatsApp support for Singapore (+65 8090 0928) and Malaysia (+60 18-902 8790). Operating daily 06:00–23:00 SGT."
  canonical="/contact/"
  jsonLd={jsonLd}
>
  <main id="main">
    <!-- Contact Hero Banner -->
    <section class="corp-hero">
      <div class="shell corp-hero-grid">
        <div class="corp-hero-content">
          <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Contact" }]} />
          <p class="section-label">Cross-Border Operations</p>
          <h1>Direct Dispatch & <span>Customer Concierge</span></h1>
          <p class="lede">
            Our operations team bridges Singapore and Malaysia with Batam Island. Connect directly with our live dispatch desks for urgent quotes, flight/ferry updates, corporate invoicing, and custom itineraries.
          </p>
          <div class="corp-hero-actions">
            <a class="button button-gold" href="https://wa.me/6580900928" target="_blank" rel="noopener noreferrer">Singapore Desk WhatsApp</a>
            <a class="button button-outline" href="https://wa.me/60189028790" target="_blank" rel="noopener noreferrer">Malaysia Desk WhatsApp</a>
          </div>
        </div>

        <aside class="corp-hero-badge-card">
          <p class="card-heading">Dispatch Operations Hours</p>
          <p style="color: rgba(255,255,255,0.85); font-size: 14.5px; line-height: 1.6; margin: 0 0 16px;">
            Our dispatch coordinators monitor incoming ferry docks and airport runways continuously throughout the day.
          </p>
          <div class="corp-stat-row">
            <div class="corp-stat-item">
              <strong>06:00–23:00</strong>
              <span>Daily Operating Hours (SGT)</span>
            </div>
            <div class="corp-stat-item">
              <strong>&lt; 15 Mins</strong>
              <span>Average Response SLA</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Dispatch Desks Cards -->
    <section class="corp-section bg-white">
      <div class="shell">
        <div class="section-intro-center">
          <p class="section-label">Dedicated Country Desks</p>
          <h2>Choose Your Preferred WhatsApp Channel</h2>
          <p>
            Connect instantly with a specialist fluent in your preferred regional payment systems and travel requirements.
          </p>
        </div>

        <div class="contact-desks-grid">
          <!-- Singapore Desk -->
          <article class="contact-desk-card">
            <div class="desk-badge-row">
              <span class="desk-region-badge">Singapore Desk</span>
              <span style="font-size: 12px; color: #166647; font-weight: 700;">● Online Now</span>
            </div>
            <h3>Singapore Travelers & Corporate</h3>
            <span class="desk-phone-display">+65 8090 0928</span>
            <p>
              Dedicated channel for travelers departing from HarbourFront Centre or Tanah Merah Ferry Terminal. Supports PayNow QR payments in SGD and corporate invoicing.
            </p>

            <div class="desk-info-list">
              <div class="desk-info-item">
                <span>Response Time:</span>
                <strong>Within 10 minutes</strong>
              </div>
              <div class="desk-info-item">
                <span>Payment Accepted:</span>
                <strong>PayNow, SGD, Visa/Mastercard</strong>
              </div>
              <div class="desk-info-item">
                <span>Languages:</span>
                <strong>English, Mandarin, Teochew, Hokkien</strong>
              </div>
            </div>

            <a class="button button-gold" style="width: 100%; margin-top: auto;" href="https://wa.me/6580900928" target="_blank" rel="noopener noreferrer">
              Chat on Singapore WhatsApp
            </a>
          </article>

          <!-- Malaysia Desk -->
          <article class="contact-desk-card">
            <div class="desk-badge-row">
              <span class="desk-region-badge" style="background: #123a6c;">Malaysia Desk</span>
              <span style="font-size: 12px; color: #166647; font-weight: 700;">● Online Now</span>
            </div>
            <h3>Malaysia Travelers & Corporate</h3>
            <span class="desk-phone-display">+60 18-902 8790</span>
            <p>
              Dedicated channel for travelers departing from Stulang Laut (Berjaya Waterfront JB) or Pasir Gudang ferry terminals. Supports Touch ’n Go eWallet and DuitNow MYR.
            </p>

            <div class="desk-info-list">
              <div class="desk-info-item">
                <span>Response Time:</span>
                <strong>Within 10 minutes</strong>
              </div>
              <div class="desk-info-item">
                <span>Payment Accepted:</span>
                <strong>Touch ’n Go, DuitNow, MYR Cash</strong>
              </div>
              <div class="desk-info-item">
                <span>Languages:</span>
                <strong>Bahasa Melayu, Mandarin, English</strong>
              </div>
            </div>

            <a class="button button-navy" style="width: 100%; margin-top: auto;" href="https://wa.me/60189028790" target="_blank" rel="noopener noreferrer">
              Chat on Malaysia WhatsApp
            </a>
          </article>
        </div>

        <!-- Terminal & Meeting Points Guide -->
        <div class="section-intro-center" style="margin-top: 24px;">
          <p class="section-label">Arrival Meeting Points</p>
          <h2>Where Your Chauffeur Meets You</h2>
          <p>
            Zero wandering or confusion. Your driver greets you right outside immigration at each port of entry.
          </p>
        </div>

        <div class="terminal-guides-grid">
          <div class="terminal-guide-card">
            <h4>Harbour Bay Ferry Terminal</h4>
            <p>
              Driver greets you right outside the glass automatic doors of the international arrival hall, near the taxi foyer.
            </p>
          </div>

          <div class="terminal-guide-card">
            <h4>Batam Centre Ferry Terminal</h4>
            <p>
              Meet at Level 1 Arrival Pick-Up Bay, right underneath the pedestrian link bridge connecting to Mega Mall.
            </p>
          </div>

          <div class="terminal-guide-card">
            <h4>Nongsapura Ferry Terminal</h4>
            <p>
              Driver greets you immediately past the luggage scanner at the resort arrival gate, ready for Nongsa resort transfers.
            </p>
          </div>

          <div class="terminal-guide-card">
            <h4>Hang Nadim Airport (BTH)</h4>
            <p>
              Chauffeur stands outside the Domestic/International arrival hall with a personalized BatamRide name placard.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Form Booking Anchor Section -->
    <section class="corp-section bg-cream">
      <div class="shell" style="text-align: center; max-width: 680px;">
        <p class="section-label">Direct Online Request</p>
        <h2>Prefer to Request a Quote Online?</h2>
        <p style="color: var(--muted); font-size: 16px; line-height: 1.6; margin-bottom: 28px;">
          Use our interactive reservation builder on the homepage to configure your pickup time, passenger count, and preferred vehicle tier.
        </p>
        <a class="button button-gold" href="/#booking">Open Reservation Builder</a>
      </div>
    </section>
  </main>
</Layout>
