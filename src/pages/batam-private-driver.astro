---
import Layout from '../layouts/Layout.astro';
import LandingHero from '../components/LandingHero.astro';
import VehicleShowcase from '../components/VehicleShowcase.astro';
import InclusionsSection from '../components/InclusionsSection.astro';
import BookingSteps from '../components/BookingSteps.astro';
import LandingFAQ from '../components/LandingFAQ.astro';
import LandingCTA from '../components/LandingCTA.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Batam Private Driver and Car Hire",
      "provider": {
        "@type": "LocalBusiness",
        "name": "BatamRide",
        "url": "https://batamride.com/"
      },
      "areaServed": {
        "@type": "City",
        "name": "Batam"
      },
      "description": "Private car with a professional driver in Batam for up to 12 hours.",
      "offers": {
        "@type": "Offer",
        "price": "70",
        "priceCurrency": "SGD",
        "description": "Full-day private transport for up to 12 hours. Fuel and ordinary parking included."
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is a private driver in Batam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BatamRide's published full-day rate starts at S$70 for up to 12 hours. The final quotation confirms the service, vehicle and any special requirements."
          }
        },
        {
          "@type": "Question",
          "name": "What is included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The confirmed private vehicle, professional driver, fuel, ordinary parking and agreed pickup and drop-off are included."
          }
        },
        {
          "@type": "Question",
          "name": "Which vehicle will I receive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our fleet includes Toyota Innova Zenix and Innova Reborn. BatamRide confirms the exact vehicle and photo with you before any deposit is requested."
          }
        },
        {
          "@type": "Question",
          "name": "Can the driver suggest places to visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Your driver can suggest attractions, shops, restaurants and massage places, and BatamRide may prepare a practical itinerary around your interests."
          }
        }
      ]
    }
  ]
};

const faqs = [
  {
    question: "How much is a private driver in Batam?",
    answer: "The published full-day rate starts at S$70 for a maximum of 12 hours. Your final quotation confirms the exact service, vehicle and any special requirements."
  },
  {
    question: "Can you arrange transport for more than seven people?",
    answer: "Yes. BatamRide arranges a Toyota Hiace or larger executive coach after confirming your group size, luggage and travel date through WhatsApp."
  },
  {
    question: "Which vehicle will I receive?",
    answer: "Our core vehicles are late-model white Toyota Innova Zenix and Toyota Innova Reborn. The exact vehicle photo and plate number are confirmed for your approval before any deposit."
  },
  {
    question: "Can the chauffeur suggest places to visit?",
    answer: "Yes. Your chauffeur can recommend top-rated seafood restaurants, spas, massage centers, shopping malls, and viewpoints, without any unscheduled or forced stops."
  }
];

const relatedLinks = [
  { title: "Arriving by ferry →", href: "/batam-ferry-terminal-transfer/" },
  { title: "Arriving at Hang Nadim (BTH) →", href: "/batam-airport-transfer/" },
  { title: "Planning from Singapore →", href: "/singapore-to-batam/" }
];
---

<Layout
  title="Batam Private Driver & Car Hire | BatamRide"
  description="Book a private car with driver in Batam from S$70 per day for up to 12 hours. Fuel and ordinary parking included, with a professional BatamRide driver."
  canonical="/batam-private-driver/"
  jsonLd={jsonLd}
>
  <main id="main">
    <!-- Hero Section -->
    <LandingHero
      breadcrumbs={[
        { name: "Home", href: "/" },
        { name: "Services", href: "/services/" },
        { name: "Private Driver in Batam" }
      ]}
      eyebrow="Private car hire with chauffeur"
      title="Private Driver in Batam —"
      titleHighlight="Your Day, Your Way"
      lede="Keep one private vehicle and a professional, uniformed BatamRide driver for your group. Plan shopping, meals, appointments, family time or sightseeing around your own schedule."
      primaryCta={{ text: "Book Your BatamRide", href: "/#booking" }}
      secondaryCta={{ text: "See what’s included", href: "#included" }}
      priceBadge="Full-Day Private Transport"
      price="S$70"
      pricePeriod="/day"
      priceDescription="Maximum 12 hours. Private vehicle, professional chauffeur, fuel, and ordinary parking included in confirmed quote."
      vehicleImage="/assets/batamride-innova-zenix-hotel.webp"
      vehicleImageAlt="BatamRide Toyota Innova Zenix Executive Transport"
      vehicleName="Toyota Innova Zenix / Reborn"
      chips={[
        "Confirmed car photos before deposit",
        "100% smoke-free cabin guarantee",
        "Multilingual executive chauffeur"
      ]}
    />

    <!-- Executive MPV Fleet Showcase -->
    <VehicleShowcase
      eyebrow="Executive MPV Fleet"
      title="Toyota Innova Zenix & Reborn"
      description="Experience Batam with late-model, smoke-free executive MPVs. Featuring whisper-quiet cabins, dual-zone tropical air conditioning, and cavernous cargo space for 4+ large suitcases or full sets of golf bags."
      features={[
        {
          title: "Real Vehicle Photos Confirmed",
          description: "You receive actual photos of your assigned car before paying any deposit.",
          badge: "Zero Bait-and-Switch"
        },
        {
          title: "Strict Smoke-Free Guarantee",
          description: "Zero cigarette or tobacco residue, daily steam sanitization.",
          badge: "100% Odorless Cabin"
        },
        {
          title: "Uniformed, Vetted Chauffeurs",
          description: "English, Mandarin, Teochew, and Hokkien language support.",
          badge: "Multilingual Team"
        }
      ]}
    />

    <!-- Inclusions & Service Scope -->
    <InclusionsSection
      id="included"
      label="Clear before confirmation"
      title="What the S$70 day service covers."
      includedTitle="Included in the S$70 day rate"
      includedItems={[
        "Private vehicle and professional uniformed chauffeur",
        "Fuel, island tolls, and ordinary parking fees",
        "Agreed pickup and final drop-off location",
        "Up to 12 hours of confirmed flexible service"
      ]}
      excludedTitle="Not automatically included"
      excludedItems={[
        "Meals, snacks, and accommodation",
        "Ferry tickets or airline charges",
        "Attraction tickets, spa, or activity entry fees",
        "Personal shopping purchases and expenses"
      ]}
      notice="Any overtime fee or special custom route will be quoted before confirmation. Availability and the exact vehicle are always verified for your travel date."
    />

    <!-- Booking Steps -->
    <BookingSteps
      eyebrow="Simple 3-Step Process"
      title="Booking steps"
      subtitle="Share the details that help us quote correctly."
      steps={[
        {
          number: "01",
          title: "Ferry and arrival",
          description: "Send the terminal, ferry name, travel date and expected arrival time.",
          badge: "Terminal & Arrival",
          icon: "ferry"
        },
        {
          number: "02",
          title: "Group and luggage",
          description: "Tell us the number of adults and children, cabin luggage and any large bags.",
          badge: "Passenger & Baggage",
          icon: "luggage"
        },
        {
          number: "03",
          title: "Day plan",
          description: "Add your first destination, planned stops and return or final drop-off time.",
          badge: "Custom Route",
          icon: "plan"
        }
      ]}
      bookingLink="/#booking"
      ctaText="Reserve Private Driver"
    />

    <!-- Frequently Asked Questions -->
    <LandingFAQ
      id="faq"
      label="Frequently asked questions"
      title="Before you book."
      faqs={faqs}
      relatedLinks={relatedLinks}
    />

    <!-- Bottom CTA Banner -->
    <LandingCTA
      title="Ready to plan your Batam ride?"
      description="Complete the booking form, review your details, then choose the official Singapore or Malaysia WhatsApp contact."
      primaryCtaText="Reserve Private Driver"
      primaryCtaHref="/#booking"
      secondaryCtaText="Contact Dispatch Desk"
      secondaryCtaHref="/contact/"
    />
  </main>
</Layout>
