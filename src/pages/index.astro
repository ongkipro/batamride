---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="BatamRide — Private Transport in Batam"
  description="Private Batam transport for Singapore and Malaysia visitors with a professional, uniformed BatamRide driver. Exact vehicle confirmed before booking."
  canonical="/"
>
  <link rel="preload" as="image" href="/assets/hero-bg-barelang.webp" type="image/webp" fetchpriority="high" slot="head" />

  <main id="main">
    <!-- Hero Section with Accessible Background Media -->
    <section class="hero" id="top">
      <div class="hero-bg-media" aria-hidden="true" role="presentation">
        <img
          class="hero-bg-img"
          src="/assets/hero-bg-barelang.webp"
          alt=""
          width="1376"
          height="768"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="hero-overlay"></div>
      </div>

      <div class="shell hero-shell">
        <div class="hero-grid">
        <div>
          <p class="eyebrow">Private transport in Batam</p>
          <h1>Batam, made <span>easy.</span></h1>
          <p class="hero-copy">
            A comfortable private vehicle, a professional, uniformed BatamRide driver, and a trip shaped around your plans—from ferry terminal pickup to a full day across the island. Your exact vehicle and photo are confirmed before booking.
          </p>
          <div class="hero-actions">
            <a class="button button-gold" href="#booking">
              Plan my ride
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a class="button button-outline" href="#included">See what’s included</a>
          </div>
          <div class="reassurance" aria-label="Service highlights">
            <span><i class="check-dot" aria-hidden="true">✓</i> Fuel &amp; parking included</span>
            <span><i class="check-dot" aria-hidden="true">✓</i> Itinerary planning available</span>
            <span><i class="check-dot" aria-hidden="true">✓</i> No unplanned stops without your approval</span>
          </div>
        </div>

        <aside class="vehicle-card" aria-label="Featured vehicle">
          <div class="vehicle-label">
            <div class="vehicle-title-wrap">
              <small class="vehicle-kicker">Featured regular vehicle</small>
              <strong class="vehicle-name" id="vehicle-name">White Toyota Innova Zenix</strong>
            </div>
            <div class="vehicle-badge" role="status">
              <span class="badge-check-icon" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 6.5L4.8 8.8L9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Confirmed before booking</span>
            </div>
          </div>
          <div class="vehicle-photo-frame">
            <img
              class="vehicle-photo"
              id="vehicle-zenix"
              data-vehicle-image="zenix"
              src="/assets/batamride-innova-zenix-hotel.webp"
              alt="White Toyota Innova Zenix in BatamRide’s premium setting"
              width="1448"
              height="1086"
              fetchpriority="high"
            />
            <img
              class="vehicle-photo"
              id="vehicle-innova"
              data-vehicle-image="innova"
              src="/assets/batamride-innova-white-hotel.webp"
              alt="White Toyota Innova in BatamRide’s premium setting"
              width="1448"
              height="1086"
              loading="lazy"
              hidden
            />
            <span class="vehicle-photo-watermark">Verified Vehicle Photo</span>
          </div>
          <div class="vehicle-options" role="group" aria-label="View BatamRide regular vehicle photos">
            <span class="vehicle-options-label">Preview:</span>
            <button class="vehicle-option" type="button" data-vehicle-target="zenix" data-vehicle-name="White Toyota Innova Zenix" aria-controls="vehicle-zenix" aria-pressed="true">Zenix</button>
            <button class="vehicle-option" type="button" data-vehicle-target="innova" data-vehicle-name="White Toyota Innova" aria-controls="vehicle-innova" aria-pressed="false">Innova</button>
          </div>
          <p class="vehicle-note">
            Our regular vehicles include a white Toyota Innova Zenix, a white Toyota Innova, and a silver 2020 Mitsubishi Xpander. Availability varies, and another suitable vehicle may be arranged when needed. We will share the exact vehicle and photo for your approval before any deposit.
          </p>
          <div class="vehicle-meta">
            <div><strong>Private</strong><span>Chauffeur only</span></div>
            <div><strong>Comfortable</strong><span>Spacious 7-seater</span></div>
            <div><strong>Flexible</strong><span>Custom schedule</span></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

    <!-- Services Section -->
    <section id="services">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="section-label">Tailored for visitors</p>
            <h2>One reliable ride for the plans that matter.</h2>
          </div>
          <p>Simple private transport for leisure, family visits, shopping days, and business travel around Batam.</p>
        </div>
        <div class="service-grid">
          <a class="service-card group" href="/batam-ferry-terminal-transfer/">
            <div class="service-card-header">
              <div class="icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 13h16M6 13l2-5h8l2 5M6 13v5m12-5v5M5 18h2m10 0h2" />
                </svg>
              </div>
              <span class="service-tag">Meet &amp; Greet</span>
            </div>
            <h3>Ferry &amp; airport pickup</h3>
            <p>Meet your driver at the terminal or airport, settle in, and travel directly to your hotel or first destination.</p>
            <span class="text-link">Ferry transfer details <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
          <a class="service-card group" href="/batam-private-driver/">
            <div class="service-card-header">
              <div class="icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8" /><path d="M12 7v5l3 2" />
                </svg>
              </div>
              <span class="service-tag">From S$70 / day</span>
            </div>
            <h3>Hourly or full-day hire</h3>
            <p>Keep one private vehicle and driver for several stops, with timing arranged around your personal schedule.</p>
            <span class="text-link">Private driver details <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
          <a class="service-card group" href="/singapore-to-batam/">
            <div class="service-card-header">
              <div class="icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 20V8l7-4 7 4v12M9 20v-5h6v5M8 10h.01M12 10h.01M16 10h.01" />
                </svg>
              </div>
              <span class="service-tag">Custom Trip</span>
            </div>
            <h3>Custom Batam itinerary</h3>
            <p>Tell us your interests and timing. BatamRide can prepare a practical itinerary, including food, shopping, and massage suggestions.</p>
            <span class="text-link">Plan from Singapore <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- SEO Links / Guides Section -->
    <section class="seo-links" aria-labelledby="transport-guides-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="section-label">Travel Guides</p>
            <h2 id="transport-guides-title">Plan your Batam transport.</h2>
          </div>
          <p>Choose the guide that matches your arrival and continue to the same BatamRide booking form when you are ready.</p>
        </div>
        <div class="service-grid">
          <a class="service-card guide-card group" href="/batam-private-driver/">
            <div class="guide-card-top">
              <span class="guide-tag">Full-Day Charter</span>
              <span class="guide-price">From S$70</span>
            </div>
            <h3>Private driver in Batam</h3>
            <p>Full-day private transport with an English or Mandarin speaking chauffeur for up to 12 hours.</p>
            <span class="text-link">View service <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
          <a class="service-card guide-card group" href="/batam-ferry-terminal-transfer/">
            <div class="guide-card-top">
              <span class="guide-tag">Ferry Pickup</span>
              <span class="guide-price">Fixed Rate</span>
            </div>
            <h3>Ferry terminal transfer</h3>
            <p>Direct meet &amp; greet pickup from Batam Centre, Harbour Bay, Sekupang, or Nongsapura.</p>
            <span class="text-link">View service <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
          <a class="service-card guide-card group" href="/batam-airport-transfer/">
            <div class="guide-card-top">
              <span class="guide-tag">Airport Transfer</span>
              <span class="guide-price">Hang Nadim (BTH)</span>
            </div>
            <h3>Hang Nadim airport transfer</h3>
            <p>Private pickup for hotel, business, or a full day around Batam with flight tracking included.</p>
            <span class="text-link">View service <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
          <a class="service-card guide-card group" href="/singapore-to-batam/">
            <div class="guide-card-top">
              <span class="guide-tag">Arrival Guide</span>
              <span class="guide-price">Singapore Connect</span>
            </div>
            <h3>Singapore to Batam guide</h3>
            <p>Connect your confirmed ferry arrival with a private driver and a practical Batam itinerary.</p>
            <span class="text-link">View guide <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- Corporate Fleet & Standards Spotlight -->
    <section class="corp-section bg-cream" style="padding: 72px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
      <div class="shell corp-story-grid">
        <div class="corp-story-copy">
          <p class="section-label">Executive Fleet</p>
          <h2>Toyota Innova Zenix &amp; Reborn</h2>
          <p>
            Experience Batam with late-model, smoke-free executive MPVs. Featuring whisper-quiet cabins, dual-zone tropical air conditioning, and cavernous cargo space for 4+ large suitcases or full sets of golf bags.
          </p>
          <ul class="service-checklist">
            <li><span class="check">✓</span> <strong>Real Vehicle Photos Confirmed:</strong> You receive actual photos of your assigned car before paying any deposit.</li>
            <li><span class="check">✓</span> <strong>Strict Smoke-Free Guarantee:</strong> Zero cigarette or tobacco residue, daily steam sanitization.</li>
            <li><span class="check">✓</span> <strong>Uniformed, Vetted Chauffeurs:</strong> English, Mandarin, Teochew, and Hokkien language support.</li>
          </ul>
          <div style="display: flex; gap: 16px; margin-top: 24px; flex-wrap: wrap;">
            <a class="button button-gold" href="/fleet/">Explore Fleet &amp; Specs</a>
            <a class="button button-outline" href="/about/">About BatamRide Standards</a>
          </div>
        </div>

        <div class="corp-story-media">
          <img 
            src="/assets/batamride-innova-zenix-hotel.webp" 
            alt="Toyota Innova Zenix premium executive MPV" 
            loading="lazy" 
          />
          <div class="corp-media-tag">
            <strong>Toyota Innova Zenix Hybrid &amp; Reborn</strong>
            <span>Executive comfort starting from S$70 / day for up to 12 hours</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience / Inclusions Section -->
    <section class="experience" id="experience">
      <div class="shell experience-grid">
        <div class="driver-visual">
          <img
            class="uniform-photo"
            src="/assets/batamride-driver-uniform-gold.png"
            alt="Official light grey BatamRide driver polo with navy chest logo and champagne-gold back-collar tagline"
            width="1312"
            height="1199"
            loading="lazy"
          />
          <div class="visual-caption">
            <div>
              <strong>Professional presentation</strong>
              <span>Light grey BatamRide polo uniform</span>
            </div>
            <em>Ready to welcome you</em>
          </div>
        </div>
        <div class="experience-copy" id="included">
          <p class="eyebrow">Clear, comfortable, considered</p>
          <h2>A better Batam arrival.</h2>
          <p>Know what to expect before you step off the ferry or plane. Your ride is private, the essentials are included, and the day stays yours.</p>
          <ul class="included-list">
            <li>
              <span class="check-dot" aria-hidden="true">✓</span>
              <span><strong>Fuel &amp; parking included</strong><span>Presented clearly in your booking request, without surprise add-ons from ordinary driving.</span></span>
            </li>
            <li>
              <span class="check-dot" aria-hidden="true">✓</span>
              <span><strong>Professional, uniformed driver</strong><span>Every confirmed driver wears our light grey BatamRide uniform, including when another suitable vehicle is arranged.</span></span>
            </li>
            <li>
              <span class="check-dot" aria-hidden="true">✓</span>
              <span><strong>Recommendations from your driver</strong><span>Your driver can suggest authentic local food, shopping centers, seafood kelongs, and vetted spa retreats.</span></span>
            </li>
            <li>
              <span class="check-dot" aria-hidden="true">✓</span>
              <span><strong>We may prepare your itinerary</strong><span>Tell us your interests and available time, and BatamRide may prepare a practical route for your trip.</span></span>
            </li>
            <li>
              <span class="check-dot" aria-hidden="true">✓</span>
              <span><strong>Multilingual driver support</strong><span>All drivers speak Bahasa Indonesia and Mandarin. Each driver also speaks either Teochew or Hokkien. An English-speaking driver may be requested in advance.</span></span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Booking Section -->
    <section class="booking-section" id="booking">
      <div class="shell booking-layout">
        <div class="booking-intro">
          <p class="eyebrow" style="color: #8c6a32">Start your request</p>
          <h2>Tell us about your ride.</h2>
          <p>Complete the essentials, review the summary, then continue with the Singapore or Malaysia WhatsApp contact you choose.</p>
          
          <aside class="payment-panel" aria-labelledby="payment-title">
            <div class="payment-heading">
              <div>
                <h3 id="payment-title">Flexible ways to pay</h3>
                <p>Choose the option that is most convenient for you.</p>
              </div>
              <span class="secure-label">After confirmation</span>
            </div>
            <div class="payment-grid" aria-label="Available payment methods">
              <div class="payment-method">
                <span class="method-logo" aria-hidden="true">
                  <img src="/assets/paynow-logo.webp" alt="PayNow" width="48" height="40" />
                </span>
                <span><strong>PayNow</strong><span>Direct Singapore transfer</span></span>
              </div>
              <div class="payment-method">
                <span class="method-logo method-logo-cards" aria-hidden="true">
                  <img src="/assets/visa-logo.svg" alt="Visa" width="30" height="16" />
                  <img src="/assets/mastercard-logo.jpg" alt="Mastercard" width="30" height="16" />
                </span>
                <span><strong>Visa &amp; Mastercard</strong><span>Securely via Stripe</span></span>
              </div>
              <div class="payment-method">
                <span class="method-logo" aria-hidden="true">
                  <img src="/assets/tng-ewallet-logo.svg" alt="Touch 'n Go" width="48" height="40" />
                </span>
                <span><strong>Touch ’n Go eWallet</strong><span>Malaysia option</span></span>
              </div>
              <div class="payment-method">
                <span class="method-logo method-logo-bank" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 10h18M5 10v8m4-8v8m6-8v8m4-8v8M3 21h18M12 3l9 4H3l9-4Z" />
                  </svg>
                </span>
                <span><strong>Bank transfer</strong><span>Singapore or Malaysia</span></span>
              </div>
            </div>
            <p class="payment-note">
              For your security, do not enter bank account, card, or other payment details in this booking form. Payment links and account details are provided only after your service and price are confirmed, and only through the official BatamRide WhatsApp contact selected in your request.
            </p>
          </aside>
        </div>

        <form class="booking-form" id="booking-form" novalidate>
          <div class="form-heading">
            <div>
              <strong>Ride details</strong>
              <span>Usually takes under two minutes</span>
            </div>
            <span class="secure-label">Private request</span>
          </div>

          <fieldset>
            <legend>What kind of ride do you need?</legend>
            <div class="choice-grid">
              <label class="choice">
                <input type="radio" name="service" id="service" value="Ferry or airport transfer" checked />
                <span class="choice-check" aria-hidden="true"></span>
                <strong>Transfer</strong>
                <span>Ferry terminal or airport pickup</span>
              </label>
              <label class="choice">
                <input type="radio" name="service" value="Hourly or full-day hire" />
                <span class="choice-check" aria-hidden="true"></span>
                <strong>Private hire</strong>
                <span>Several stops over part or all of the day</span>
              </label>
              <label class="choice">
                <input type="radio" name="service" value="Custom itinerary" />
                <span class="choice-check" aria-hidden="true"></span>
                <strong>Custom trip</strong>
                <span>Let BatamRide plan around your interests</span>
              </label>
            </div>
          </fieldset>

          <div class="form-grid">
            <div class="field">
              <label for="travel-date">Travel date</label>
              <input id="travel-date" name="travel-date" type="date" required />
            </div>
            <div class="field">
              <label for="travel-time">Pickup time</label>
              <input id="travel-time" name="travel-time" type="time" value="09:00" required />
            </div>
            <div class="field">
              <label for="end-date">Return / final drop-off date</label>
              <input id="end-date" name="end-date" type="date" required />
            </div>
            <div class="field">
              <label for="end-time">Return / final drop-off time</label>
              <input id="end-time" name="end-time" type="time" value="18:00" required />
            </div>
            <div class="field">
              <label for="pickup">Pickup location</label>
              <input id="pickup" name="pickup" type="text" placeholder="e.g. Batam Centre Ferry Terminal" autocomplete="street-address" required />
            </div>
            <div class="field">
              <label for="destination">First destination</label>
              <input id="destination" name="destination" type="text" placeholder="Hotel, address, or area" required />
            </div>
            <div class="field full">
              <label for="final-dropoff">Final drop-off location</label>
              <input id="final-dropoff" name="final-dropoff" type="text" placeholder="e.g. Batam Centre Ferry Terminal, airport, or hotel" required />
            </div>
            <div class="field">
              <label for="passengers">Passengers</label>
              <div class="counter">
                <button type="button" data-counter="passengers" data-direction="down" aria-label="Remove one passenger">−</button>
                <output id="passengers" data-value="2">2</output>
                <button type="button" data-counter="passengers" data-direction="up" aria-label="Add one passenger">+</button>
              </div>
              <p class="field-note">More than 7 guests? Select the full group size and continue to WhatsApp. We may arrange a Hiace or larger bus.</p>
            </div>
            <div class="field">
              <label for="luggage">Cabin-size luggage</label>
              <div class="counter">
                <button type="button" data-counter="luggage" data-direction="down" aria-label="Remove one cabin-size luggage item">−</button>
                <output id="luggage" data-value="1">1</output>
                <button type="button" data-counter="luggage" data-direction="up" aria-label="Add one cabin-size luggage item">+</button>
              </div>
              <p class="field-note">Please describe any large or oversized luggage in Extra details.</p>
            </div>
            <details class="capacity-guide">
              <summary>Group size &amp; luggage guide</summary>
              <div>
                <p><strong>Toyota Innova Zenix:</strong> Up to 7 guests for a day tour without luggage. With cabin-size luggage, a practical setup is 5 adults and 1 child, with one seat folded for bags.</p>
                <p><strong>Toyota Innova:</strong> Up to 6 guests without luggage. With cabin-size luggage, a practical setup is 4 adults and 1 child, with one seat folded for bags.</p>
                <p><strong>Larger groups:</strong> For more than 7 guests, BatamRide may arrange a Hiace or larger bus after confirming the group size, cabin-size luggage, any larger bags, and availability through WhatsApp.</p>
              </div>
            </details>
            <div class="field full">
              <label for="guest-name">Your name</label>
              <input id="guest-name" name="guest-name" type="text" placeholder="Name for the booking" autocomplete="name" required />
            </div>
            <div class="field full">
              <label>Send booking through</label>
              <div class="region-toggle" id="contact-region">
                <label><input type="radio" name="region" value="Singapore" checked /> 🇸🇬 Singapore contact (+65)</label>
                <label><input type="radio" name="region" value="Malaysia" /> 🇲🇾 Malaysia contact (+60)</label>
              </div>
              <p class="region-help" id="region-hint">Your booking summary will be routed to BatamRide Singapore WhatsApp (+65 8090 0928).</p>
            </div>
            <div class="field full">
              <label for="notes">Extra details <span>(optional)</span></label>
              <textarea id="notes" name="notes" placeholder="Ferry name, large or oversized luggage, child seat request, planned stops, or anything else we should know"></textarea>
            </div>
          </div>

          <div class="form-footer">
            <p>No payment is taken on this page. After we confirm your service, availability, exact vehicle and photo, a small booking deposit of S$10–S$20 may be requested. Payment links or instructions will be sent privately through WhatsApp.</p>
            <button class="button button-navy group" type="submit">
              Review &amp; continue to WhatsApp 
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </button>
          </div>
          <p class="form-status" id="form-status" role="alert" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- Quick Chat Section -->
    <section class="quick-chat" aria-labelledby="quick-chat-title">
      <div class="shell quick-chat-row">
        <div class="quick-chat-copy">
          <h2 id="quick-chat-title">Need to ask us first?</h2>
          <p>Chat directly with BatamRide through one of our official WhatsApp contacts.</p>
        </div>
        <div class="quick-chat-links" aria-label="Official BatamRide WhatsApp contacts">
          <a class="whatsapp-link" href="https://wa.me/6580900928" target="_blank" rel="noopener noreferrer" aria-label="Chat with BatamRide Singapore on WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Singapore WhatsApp
