  </main>

  <!-- Review Modal -->
  <div class="modal" id="summary-modal" role="dialog" aria-modal="true" aria-labelledby="summary-title">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h2 id="summary-title">Review your ride</h2>
          <p>Check the details before continuing.</p>
        </div>
        <button class="close-button" id="close-modal" type="button" aria-label="Close booking summary">×</button>
      </div>
      <dl class="summary-list" id="booking-summary"></dl>
      <p class="deposit-note">After your service details, availability, exact vehicle and photo are confirmed, a small booking deposit of S$10–S$20 may be requested. Your payment link or instructions will be sent privately through WhatsApp.</p>
      <p class="placeholder-note" id="contact-note" hidden></p>
      <div class="modal-actions">
        <button class="button button-outline" id="copy-request" type="button">Copy request</button>
        <a class="button button-navy" id="continue-whatsapp" href="#" target="_blank" rel="noopener noreferrer" style="background: linear-gradient(135deg, #128C7E 0%, #075E54 100%);">Continue to WhatsApp</a>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite">✓ Booking request copied to clipboard</div>

  <!-- Interactive Client Script -->
  <script is:inline>
    const CONTACTS = {
      Singapore: { display: "+65 8090 0928", whatsapp: "6580900928" },
      Malaysia: { display: "+60 18-902 8790", whatsapp: "60189028790" },
    };

    const form = document.querySelector("#booking-form");
    const modal = document.querySelector("#summary-modal");
    const closeModalButton = document.querySelector("#close-modal");
    const summary = document.querySelector("#booking-summary");
    const contactNote = document.querySelector("#contact-note");
    const continueButton = document.querySelector("#continue-whatsapp");
    const copyButton = document.querySelector("#copy-request");
    const status = document.querySelector("#form-status");
    const toast = document.querySelector("#toast");
    const vehicleName = document.querySelector("#vehicle-name");
    const vehicleImages = [...document.querySelectorAll("[data-vehicle-image]")];
    const vehicleOptions = [...document.querySelectorAll("[data-vehicle-target]")];
    const regionRadios = document.querySelectorAll('input[name="region"]');
    const regionHint = document.querySelector("#region-hint");
    let bookingMessage = "";
    let lastFocusedElement = null;

    vehicleOptions.forEach((button) => {
      button.addEventListener("click", () => {
        vehicleOptions.forEach((option) => option.setAttribute("aria-pressed", String(option === button)));
        vehicleImages.forEach((image) => {
          image.hidden = image.dataset.vehicleImage !== button.dataset.vehicleTarget;
        });
        if (vehicleName) vehicleName.textContent = button.dataset.vehicleName;
      });
    });

    const dateInput = document.querySelector("#travel-date");
    const endDateInput = document.querySelector("#end-date");
    if (dateInput && endDateInput) {
      const localToday = new Date();
      localToday.setMinutes(localToday.getMinutes() - localToday.getTimezoneOffset());
      const todayIso = localToday.toISOString().split("T")[0];
      dateInput.min = todayIso;
      if (!dateInput.value) {
        dateInput.value = todayIso;
      }
      endDateInput.min = dateInput.value || todayIso;
      if (!endDateInput.value) {
        endDateInput.value = dateInput.value || todayIso;
      }

      dateInput.addEventListener("change", () => {
        endDateInput.min = dateInput.value || dateInput.min;
        if (endDateInput.value && endDateInput.value < endDateInput.min) {
          endDateInput.value = endDateInput.min;
        }
      });
    }

    regionRadios.forEach((radio) => {
      radio.addEventListener("change", (e) => {
        const selected = e.target.value;
        if (regionHint) {
          const info = CONTACTS[selected];
          regionHint.textContent = `Your booking summary will be routed to BatamRide ${selected} WhatsApp (${info.display}).`;
        }
      });
    });

    document.querySelectorAll("[data-counter]").forEach((button) => {
      button.addEventListener("click", () => {
        const output = document.querySelector(`#${button.dataset.counter}`);
        if (!output) return;
        const current = Number(output.dataset.value);
        const min = button.dataset.counter === "passengers" ? 1 : 0;
        const next = button.dataset.direction === "up" ? current + 1 : current - 1;
        const value = Math.max(min, next);
        output.dataset.value = String(value);
        output.textContent = String(value);
      });
    });

    const formatDate = (value) => {
      if (!value) return "";
      return new Intl.DateTimeFormat("en-SG", {
        day: "numeric",
        month: "short",
        year: "numeric",
      }).format(new Date(`${value}T12:00:00`));
    };

    const getBooking = () => {
      const formData = new FormData(form);
      const paxEl = document.querySelector("#passengers");
      const lugEl = document.querySelector("#luggage");
      return {
        service: formData.get("service"),
        date: formatDate(formData.get("travel-date")),
        time: formData.get("travel-time"),
        endDate: formatDate(formData.get("end-date")),
        endTime: formData.get("end-time"),
        pickup: String(formData.get("pickup") || "").trim(),
        destination: String(formData.get("destination") || "").trim(),
        finalDropoff: String(formData.get("final-dropoff") || "").trim(),
        passengers: paxEl ? paxEl.dataset.value : "2",
        luggage: lugEl ? lugEl.dataset.value : "1",
        name: String(formData.get("guest-name") || "").trim(),
        region: formData.get("region") || "Singapore",
        notes: String(formData.get("notes") || "").trim(),
      };
    };

    const validateForm = () => {
      const required = [...form.querySelectorAll("[required]")];
      const firstInvalid = required.find((field) => !field.value.trim());
      if (firstInvalid) {
        firstInvalid.focus();
        if (status) status.textContent = "Please complete the highlighted ride details.";
        return false;
      }
      if (dateInput.value < dateInput.min) {
        dateInput.focus();
        if (status) status.textContent = "Please choose today or a future travel date.";
        return false;
      }
      const startValue = `${dateInput.value}T${form.elements["travel-time"].value}`;
      const endValue = `${endDateInput.value}T${form.elements["end-time"].value}`;
      if (endValue <= startValue) {
        endDateInput.focus();
        if (status) status.textContent = "Please choose a return or final drop-off time after the pickup time.";
        return false;
      }
      if (status) status.textContent = "";
      return true;
    };

    const buildMessage = (booking) => {
      const lines = [
        "Hello BatamRide, I would like to request a private ride.",
        "",
        `Name: ${booking.name}`,
        `Service: ${booking.service}`,
        `Pickup date & time: ${booking.date}, ${booking.time}`,
        `Return / final drop-off: ${booking.endDate}, ${booking.endTime}`,
        `Pickup: ${booking.pickup}`,
        `First destination: ${booking.destination}`,
        `Final drop-off location: ${booking.finalDropoff}`,
        `Passengers: ${booking.passengers}`,
        `Cabin-size luggage: ${booking.luggage}`,
        ...(Number(booking.passengers) > 7 ? ["Large-group vehicle: Please advise on a Hiace or larger bus, subject to availability."] : []),
        "Vehicle: Please confirm the exact vehicle and photo before booking.",
        "Driver: Professional, uniformed BatamRide driver",
        "Fuel & parking: Included",
        "Deposit: I understand that a small booking deposit of S$10–S$20 may be requested after the service, availability, exact vehicle and photo are confirmed.",
      ];
      if (booking.notes) lines.push(`Extra details: ${booking.notes}`);
      lines.push("", "Please confirm availability, the exact vehicle and photo, and the total price. Thank you.");
      return lines.join("\n");
    };

    const escapeHtml = (text) =>
      String(text)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const renderSummary = (booking) => {
      const rows = [
        ["Name", booking.name],
        ["Service", booking.service],
        ["Pickup date & time", `${booking.date}, ${booking.time}`],
        ["Return / final drop-off", `${booking.endDate}, ${booking.endTime}`],
        ["Pickup", booking.pickup],
        ["First destination", booking.destination],
        ["Final drop-off location", booking.finalDropoff],
        ["Group", `${booking.passengers} passenger${booking.passengers === "1" ? "" : "s"} · ${booking.luggage} cabin-size luggage`],
        ["Vehicle", Number(booking.passengers) > 7 ? "Hiace or larger bus request—exact vehicle and photo to be confirmed" : "Exact vehicle and photo confirmed before booking"],
        ["Driver", "Professional, uniformed BatamRide driver"],
        ["Included", "Fuel & parking"],
        ["Deposit", "S$10–S$20 may be requested after confirmation"],
        ["WhatsApp", `${booking.region} · ${CONTACTS[booking.region].display}`],
      ];
      if (booking.notes) rows.push(["Extra details", booking.notes]);
      if (summary) {
        summary.innerHTML = rows
          .map(([label, value]) => `<div class="summary-row"><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`)
          .join("");
      }

      const contact = CONTACTS[booking.region];
      if (continueButton) {
        continueButton.removeAttribute("aria-disabled");
        continueButton.textContent = `Continue to ${booking.region} WhatsApp`;
        continueButton.href = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(bookingMessage)}`;
      }
    };

    const openModal = () => {
      lastFocusedElement = document.activeElement;
      if (modal) modal.classList.add("open");
      document.body.classList.add("modal-open");
      if (closeModalButton) closeModalButton.focus();
    };

    const closeModal = () => {
      if (modal) modal.classList.remove("open");
      document.body.classList.remove("modal-open");
      lastFocusedElement?.focus();
    };

    if (form) {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!validateForm()) return;
        const booking = getBooking();
        bookingMessage = buildMessage(booking);
        renderSummary(booking);
        openModal();
      });
    }

    if (closeModalButton) closeModalButton.addEventListener("click", closeModal);
    if (modal) {
      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeModal();
      });
    }
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal && modal.classList.contains("open")) closeModal();
    });

    if (copyButton) {
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(bookingMessage);
        } catch {
          const area = document.createElement("textarea");
          area.value = bookingMessage;
          document.body.appendChild(area);
          area.select();
          document.execCommand("copy");
          area.remove();
        }
        if (toast) {
          toast.classList.add("show");
          window.setTimeout(() => toast.classList.remove("show"), 2000);
        }
      });
    }
  </script>
</Layout>
