---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  image?: string;
  jsonLd?: Record<string, any>;
  themeColor?: string;
}

const {
  title = "BatamRide — Private Transport in Batam",
  description = "Private Batam transport for Singapore and Malaysia visitors with a professional, uniformed BatamRide driver. Exact vehicle confirmed before booking.",
  canonical = Astro.url.pathname,
  ogType = "website",
  image = "/assets/batamride-innova-zenix-hotel.webp",
  jsonLd,
  themeColor = "#081d3b"
} = Astro.props;

const canonicalURL = canonical.startsWith('http') 
  ? canonical 
  : `https://batamride.com${canonical.startsWith('/') ? canonical : `/${canonical}`}`;

const imageURL = image.startsWith('http')
  ? image
  : `https://batamride.com${image.startsWith('/') ? image : `/${image}`}`;

const defaultLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "BatamRide",
  "url": "https://batamride.com/",
  "logo": "https://batamride.com/assets/batamride-logo.webp",
  "image": "https://batamride.com/assets/batamride-innova-zenix-hotel.webp",
  "description": "Private transport in Batam for visitors from Singapore and Malaysia, with professional uniformed drivers.",
  "areaServed": { "@type": "City", "name": "Batam" },
  "telephone": ["+6580900928", "+60189028790"],
  "priceRange": "S$70 per day for up to 12 hours",
  "sameAs": ["https://wa.me/6580900928", "https://wa.me/60189028790"]
};

const activeSchema = jsonLd || defaultLocalBusinessSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts Preconnect & Luxury Font Stack -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" 
      rel="stylesheet" 
    />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BatamRide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_SG" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(activeSchema)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    
    <slot />

    <Footer />
  </body>
</html>
