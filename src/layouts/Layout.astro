---
import '../styles/global.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "BatamRide | Premium Private Transport & Curated Tours in Batam",
  description = "Private transport in Batam for travelers from Singapore and Malaysia. Guaranteed white Toyota Innova Zenix, professional uniformed drivers, transparent rates, and effortless WhatsApp booking.",
  image = "/images/hero-zenix.webp"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://batamride.com');

const globalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "BatamRide - Premium Private Transport & Tours",
  "image": "https://batamride.com/images/hero-zenix.webp",
  "@id": "https://batamride.com",
  "url": "https://batamride.com",
  "telephone": "+628127003708",
  "priceRange": "SGD 55 - 110",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Batam Centre Ferry Terminal Area",
    "addressLocality": "Batam",
    "addressRegion": "Kepulauan Riau",
    "postalCode": "29432",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 1.1301,
    "longitude": 104.0529
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "06:00",
    "closes": "23:00"
  },
  "areaServed": ["Singapore", "Malaysia", "Batam"]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="BatamRide" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Global JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(globalBusinessSchema)} />
    
    <slot name="head" />

    <!-- Preload Critical LCP Hero Image in WebP -->
    <link rel="preload" as="image" href="/images/hero-zenix.webp" type="image/webp" fetchpriority="high" />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-amber-100 selection:text-amber-900 pb-16 sm:pb-0">
    <slot />

    <!-- Global Floating WhatsApp Concierge -->
    <FloatingWhatsApp />
  </body>
</html>
