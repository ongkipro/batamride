---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/services/', label: 'Services' },
  { href: '/fleet/', label: 'Fleet' },
  { href: '/about/', label: 'About Us' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' }
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="shell nav-container">
    <a class="brand" href="/" aria-label="BatamRide Home — Professional Private Chauffeur & Executive Fleet">
      <img 
        class="brand-logo" 
        src="/assets/batamride-logo-white.webp" 
        alt="BatamRide — Your Trusted Batam Travel Partner" 
        width="188" 
        height="33"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class:list={['nav-item', { active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <div class="header-dispatch-pill" title="Fast WhatsApp Dispatch for Singapore & Malaysia">
        <span class="dispatch-dot" aria-hidden="true"></span>
        <span class="dispatch-text"><strong>Dispatch Live</strong> 06:00–23:00</span>
      </div>
      <a class="button button-gold header-cta" href="/#booking">
        <span>Book Your Ride</span>
      </a>
      <!-- Mobile Menu Toggle Button -->
      <button 
        type="button" 
        class="mobile-menu-btn" 
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu" 
        aria-expanded="false" 
        aria-controls="mobile-nav-drawer"
      >
        <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="mobile-drawer-header">
        <span class="mobile-drawer-title">Navigation</span>
      </div>
      <nav class="mobile-nav-links" aria-label="Mobile navigation">
        <a href="/" class:list={['mobile-nav-item', { active: currentPath === '/' }]}>
          <span>Home</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class:list={['mobile-nav-item', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span>{link.label}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ))}
      </nav>

      <div class="mobile-drawer-footer">
        <div class="mobile-drawer-contacts">
          <p class="mobile-dispatch-heading">Instant WhatsApp Dispatch</p>
          <a href="https://wa.me/6580900928" class="mobile-contact-link" target="_blank" rel="noopener noreferrer">
            <span class="country-badge">SG</span>
            <span>+65 8090 0928</span>
          </a>
          <a href="https://wa.me/60189028790" class="mobile-contact-link" target="_blank" rel="noopener noreferrer">
            <span class="country-badge">MY</span>
            <span>+60 18-902 8790</span>
          </a>
        </div>
        <a class="button button-gold mobile-drawer-cta" href="/#booking">
          Reserve Your Ride
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer logic with ESC key & backdrop close
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.setAttribute('aria-hidden', String(isExpanded));
      document.body.classList.toggle('nav-drawer-open', !isExpanded);
    };

    toggleBtn.addEventListener('click', toggleMenu);

    // Close on link click inside drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('nav-drawer-open');
      });
    });

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  }

  // Header scroll state
  const header = document.querySelector('.site-header');
  if (header) {
    const updateHeader = () => {
      if (window.scrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }
</script>
