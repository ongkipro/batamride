---
import { ChevronLeft, ChevronRight, ShieldCheck, Sparkles } from '@lucide/astro';

const slides = [
  {
    image: '/images/hero-zenix.jpg',
    title: 'Guaranteed Toyota Innova Zenix',
    subtitle: 'Modern White MPV • Multi-Zone Air Conditioning',
    badge: 'Official Fleet Standard'
  },
  {
    image: '/images/zenix-interior.jpg',
    title: 'Executive Captain Seats Cabin',
    subtitle: '6-Adult Capacity • 5 Large Suitcases Boot Space',
    badge: 'Spacious & Clean'
  },
  {
    image: '/images/barelang-sunset.jpg',
    title: 'Barelang Golden Hour Tours',
    subtitle: 'Bridges 1 to 6 • Scenic Coastal Itineraries',
    badge: 'Curated Sightseeing'
  },
  {
    image: '/images/driver-uniform.jpg',
    title: 'Uniformed Chauffeur Meet & Greet',
    subtitle: 'Personalized Signboard at Ferry & Airport Gates',
    badge: 'Professional Service'
  }
];
---

<!-- Interactive Hero Visual Slider with Refined Framing -->
<div id="hero-slider" class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-xl border border-slate-200/90 bg-slate-950 group select-none">
  
  <!-- Slides Container -->
  <div class="relative h-72 sm:h-96 md:h-[400px] w-full overflow-hidden">
    {slides.map((slide, index) => (
      <div 
        class={`slide-item absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-slide-index={index}
      >
        <img 
          src={slide.image} 
          alt={slide.title} 
          class="w-full h-full object-cover"
          loading={index === 0 ? "eager" : "lazy"}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></div>
        
        <!-- Top Badge on Slide -->
        <div class="absolute top-3.5 left-3.5 sm:top-4 sm:left-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-bold bg-[#0B2348]/90 text-white backdrop-blur-md border border-white/20 shadow-xs">
            <Sparkles class="w-3 h-3 text-[#D2AD68]" />
            <span>{slide.badge}</span>
          </span>
        </div>

        <!-- Bottom Caption Box -->
        <div class="absolute bottom-3.5 inset-x-3.5 sm:bottom-4 sm:inset-x-4 p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-slate-950/85 backdrop-blur-md border border-white/10 text-white shadow-md">
          <div class="font-black text-white text-sm sm:text-base tracking-tight leading-snug">{slide.title}</div>
          <div class="text-slate-300 text-[11px] sm:text-xs mt-0.5 font-medium">{slide.subtitle}</div>
        </div>
      </div>
    ))}
  </div>

  <!-- Navigation Arrows -->
  <button 
    id="slider-prev"
    aria-label="Previous Slide"
    class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-slate-950/60 hover:bg-slate-950 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-0 group-hover:opacity-100 cursor-pointer"
  >
    <ChevronLeft class="w-4 h-4 sm:w-5 sm:h-5" />
  </button>
  <button 
    id="slider-next"
    aria-label="Next Slide"
    class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-slate-950/60 hover:bg-slate-950 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-0 group-hover:opacity-100 cursor-pointer"
  >
    <ChevronRight class="w-4 h-4 sm:w-5 sm:h-5" />
  </button>

  <!-- Slider Indicator Dots -->
  <div class="absolute top-3.5 right-3.5 sm:top-4 sm:right-4 z-20 flex items-center gap-1.5 bg-slate-950/60 backdrop-blur-md px-2.5 py-1.5 rounded-full border border-white/15">
    {slides.map((_, index) => (
      <button 
        class={`slider-dot h-1.5 rounded-full transition-all cursor-pointer ${index === 0 ? 'bg-[#D2AD68] w-5' : 'bg-white/40 w-1.5'}`}
        data-dot-index={index}
        aria-label={`Go to slide ${index + 1}`}
      />
    ))}
  </div>

</div>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.slide-item');
  const dots = document.querySelectorAll('.slider-dot');
  const prevBtn = document.getElementById('slider-prev');
  const nextBtn = document.getElementById('slider-next');
  const sliderContainer = document.getElementById('hero-slider');
  let intervalId: ReturnType<typeof setInterval> | null = null;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove('bg-white/40', 'w-1.5');
        dot.classList.add('bg-[#D2AD68]', 'w-5');
      } else {
        dot.classList.remove('bg-[#D2AD68]', 'w-5');
        dot.classList.add('bg-white/40', 'w-1.5');
      }
    });

    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % slides.length;
    showSlide(next);
  }

  function prevSlide() {
    const prev = (currentSlide - 1 + slides.length) % slides.length;
    showSlide(prev);
  }

  function startAutoPlay() {
    if (intervalId) clearInterval(intervalId);
    intervalId = setInterval(nextSlide, 4500);
  }

  function stopAutoPlay() {
    if (intervalId) clearInterval(intervalId);
  }

  prevBtn?.addEventListener('click', () => {
    prevSlide();
    startAutoPlay();
  });

  nextBtn?.addEventListener('click', () => {
    nextSlide();
    startAutoPlay();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
      showSlide(idx);
      startAutoPlay();
    });
  });

  sliderContainer?.addEventListener('mouseenter', stopAutoPlay);
  sliderContainer?.addEventListener('mouseleave', startAutoPlay);

  // Start initial auto-play
  startAutoPlay();
</script>
