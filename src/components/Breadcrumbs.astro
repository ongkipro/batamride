---
interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items = [], class: className = '' } = Astro.props;

// Build Schema.org BreadcrumbList JSON-LD
const schemaList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    ...(item.href ? { "item": item.href.startsWith('http') ? item.href : `https://batamride.com${item.href}` } : {})
  }))
};
---

<nav aria-label="Breadcrumb" class:list={['breadcrumbs-nav', className]}>
  <ol class="breadcrumbs-list" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          {item.href && !isLast ? (
            <a href={item.href} class="breadcrumb-link" itemprop="item">
              <span itemprop="name">{item.name}</span>
            </a>
          ) : (
            <span class="breadcrumb-current" itemprop="name" aria-current={isLast ? "page" : undefined}>
              {item.name}
            </span>
          )}
          <meta itemprop="position" content={String(index + 1)} />
          {!isLast && (
            <span class="breadcrumb-separator" aria-hidden="true">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </span>
          )}
        </li>
      );
    })}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(schemaList)} />
</nav>

<style>
  .breadcrumbs-nav {
    display: block;
    margin-bottom: 14px;
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 6px;
    font-size: 13px;
    line-height: 1.4;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .breadcrumb-link {
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .breadcrumb-link:hover {
    color: var(--gold-soft, #ead8b6);
    text-decoration: underline;
  }

  .breadcrumb-current {
    color: var(--gold-soft, #ead8b6);
    font-weight: 600;
  }

  .breadcrumb-separator {
    display: inline-flex;
    align-items: center;
    color: rgba(197, 161, 96, 0.65);
  }

  @media (max-width: 640px) {
    .breadcrumbs-nav {
      margin-bottom: 10px;
    }

    .breadcrumbs-list {
      font-size: 12px;
      gap: 4px;
    }
  }
</style>
