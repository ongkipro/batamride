---
interface StepItem {
  number: string;
  title: string;
  description: string;
  badge?: string;
  icon?: 'ferry' | 'luggage' | 'plan';
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  steps?: StepItem[];
  bookingLink?: string;
  ctaText?: string;
}

const {
  eyebrow = "Effortless Reservation",
  title = "Booking steps",
  subtitle = "Share the details that help us quote correctly.",
  steps = [
    {
      number: "01",
      title: "Ferry and arrival",
      description: "Send the terminal, ferry name, travel date and expected arrival time.",
      badge: "Arrival Schedule",
      icon: "ferry"
    },
    {
      number: "02",
      title: "Group and luggage",
      description: "Tell us the number of adults and children, cabin luggage and any large bags.",
      badge: "Vehicle Sizing",
      icon: "luggage"
    },
    {
      number: "03",
      title: "Day plan",
      description: "Add your first destination, planned stops and return or final drop-off time.",
      badge: "Custom Route",
      icon: "plan"
    }
  ],
  bookingLink = "/#booking",
  ctaText = "Start Your Booking"
} = Astro.props;
---

<section class="booking-steps-section" id="booking-steps">
  <div class="shell">
    <div class="steps-header">
      <p class="steps-eyebrow">{eyebrow}</p>
      <h2 class="steps-title">{title}</h2>
      <p class="steps-subtitle">{subtitle}</p>
    </div>

    <!-- Steps Grid -->
    <div class="steps-grid">
      {steps.map((step) => (
        <article class="step-card">
          <div class="step-top-row">
            <span class="step-num">{step.number}</span>
            <div class="step-icon-wrap" aria-hidden="true">
              {step.icon === 'ferry' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 20a6 6 0 0 0 12 0 6 6 0 0 0 12 0"/>
                  <path d="M4 18l2-9h12l2 9"/>
                  <path d="M12 9V3"/>
                  <path d="M8 6h8"/>
                </svg>
              )}
              {step.icon === 'luggage' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="16" height="14" x="4" y="7" rx="2"/>
                  <path d="M9 7V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v3"/>
                  <path d="M4 12h16"/>
                  <circle cx="8" cy="18" r="1"/>
                  <circle cx="16" cy="18" r="1"/>
                </svg>
              )}
              {(step.icon === 'plan' || !step.icon) && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
                  <line x1="9" y1="3" x2="9" y2="18"/>
                  <line x1="15" y1="6" x2="15" y2="21"/>
                </svg>
              )}
            </div>
          </div>

          <div class="step-content">
            {step.badge && <span class="step-badge">{step.badge}</span>}
            <h3 class="step-name">{step.title}</h3>
            <p class="step-text">{step.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Reassurance Banner -->
    <div class="steps-reassurance-box">
      <div class="reassurance-left">
        <span class="reassurance-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </span>
        <div class="reassurance-text">
          <strong>Photo Confirmation Before Deposit</strong>
          <p>Within 15 minutes during dispatch hours (06:00 – 23:00 SGT), our team shares actual car photos and a guaranteed transparent quote on WhatsApp.</p>
        </div>
      </div>
      <a class="button button-gold steps-cta" href={bookingLink}>
        {ctaText}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .booking-steps-section {
    padding: 88px 0 92px;
    background: #ffffff;
    position: relative;
  }

  .steps-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 52px;
  }

  .steps-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--gold);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .steps-eyebrow::before,
  .steps-eyebrow::after {
    content: "";
    width: 20px;
    height: 1.5px;
    background: var(--gold);
  }

  .steps-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy-950);
    margin: 0 0 14px;
  }

  .steps-subtitle {
    margin: 0;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 40px;
  }

  .step-card {
    position: relative;
    padding: 34px 28px;
    background: #ffffff;
    border: 1px solid rgba(8, 29, 59, 0.09);
    border-top: 3px solid var(--gold);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(4, 15, 32, 0.04);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    display: flex;
    flex-direction: column;
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(4, 15, 32, 0.09);
    border-top-color: var(--gold-deep);
  }

  .step-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .step-num {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .step-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(8, 29, 59, 0.05);
    color: var(--navy-900);
  }

  .step-card:hover .step-icon-wrap {
    background: var(--navy-900);
    color: #ffffff;
    transition: all 200ms ease;
  }

  .step-badge {
    display: inline-block;
    padding: 3px 9px;
    background: rgba(197, 161, 96, 0.12);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 750;
    color: var(--gold-deep);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }

  .step-name {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--navy-950);
    margin: 0 0 12px;
    letter-spacing: -0.015em;
  }

  .step-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-soft);
  }

  /* Reassurance Box */
  .steps-reassurance-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 24px 32px;
    background: linear-gradient(135deg, rgba(8, 29, 59, 0.03) 0%, rgba(197, 161, 96, 0.08) 100%);
    border: 1px solid rgba(197, 161, 96, 0.3);
    border-radius: 18px;
  }

  .reassurance-left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .reassurance-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--navy-900);
    color: var(--gold-soft);
    flex-shrink: 0;
    box-shadow: 0 6px 16px rgba(8, 29, 59, 0.2);
  }

  .reassurance-text strong {
    display: block;
    font-size: 15.5px;
    font-weight: 750;
    color: var(--navy-950);
    margin-bottom: 4px;
  }

  .reassurance-text p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-soft);
  }

  .steps-cta {
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Responsive Rules */
  @media (max-width: 980px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .steps-reassurance-box {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 22px 20px;
    }

    .steps-cta {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .booking-steps-section {
      padding: 60px 0 68px;
    }

    .steps-header {
      margin-bottom: 36px;
    }

    .steps-title {
      font-size: clamp(28px, 7vw, 36px);
    }

    .steps-subtitle {
      font-size: 15.5px;
    }

    .step-card {
      padding: 26px 20px;
    }
  }
</style>
