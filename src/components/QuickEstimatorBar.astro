---
import { terminals } from '../data/terminals';
import { ArrowRight, Check, MapPin, Clock } from '@lucide/astro';
---

<!-- Perfected Minimalist Quick Estimator Bar (Mobile & Desktop Clean Alignment) -->
<div class="relative -mt-6 sm:-mt-10 z-20 max-w-5xl mx-auto px-4 sm:px-6">
  <div class="bg-white rounded-2xl sm:rounded-3xl shadow-lg border border-slate-100 p-5 sm:p-7 space-y-5">
    
    <!-- Top Row: Selectors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Field 1: Pickup Terminal -->
      <div class="space-y-1.5">
        <label for="estimator-terminal" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
          <MapPin class="w-3.5 h-3.5 text-[#B88A3B]" />
          <span>Arrival Port / Pickup Point</span>
        </label>
        <select 
          id="estimator-terminal"
          class="w-full bg-slate-50 border border-slate-200 text-slate-900 font-semibold text-xs sm:text-sm rounded-xl px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-[#0B2348] transition-colors cursor-pointer"
        >
          {terminals.map(t => (
            <option value={t.name}>{t.shortName}</option>
          ))}
        </select>
      </div>

      <!-- Field 2: Service Type -->
      <div class="space-y-1.5">
        <label for="estimator-service" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
          <Clock class="w-3.5 h-3.5 text-[#B88A3B]" />
          <span>Service Type / Tour Scope</span>
        </label>
        <select 
          id="estimator-service"
          class="w-full bg-slate-50 border border-slate-200 text-slate-900 font-semibold text-xs sm:text-sm rounded-xl px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-[#0B2348] transition-colors cursor-pointer"
        >
          <option value="full-day" data-sgd="SGD 85 - 110" data-myr="MYR 280 - 350" data-idr="IDR 950k - 1.2M">
            Full-Day Private Charter (10 - 12h)
          </option>
          <option value="half-day" data-sgd="SGD 55 - 75" data-myr="MYR 240 - 260" data-idr="IDR 650k - 800k">
            Half-Day City Charter (4 - 6h)
          </option>
          <option value="transfer" data-sgd="SGD 25 - 35" data-myr="MYR 85 - 120" data-idr="IDR 300k - 400k">
            One-Way Terminal Transfer
          </option>
          <option value="tour-barelang" data-sgd="SGD 95" data-myr="MYR 310" data-idr="IDR 1.05M">
            Barelang Sunset Tour Package
          </option>
          <option value="tour-nagoya" data-sgd="SGD 95" data-myr="MYR 310" data-idr="IDR 1.05M">
            Nagoya Shopping & Spa Tour
          </option>
          <option value="tour-kelong" data-sgd="SGD 105" data-myr="MYR 340" data-idr="IDR 1.15M">
            Kelong Seafood Feast Tour
          </option>
        </select>
      </div>

    </div>

    <!-- Middle Row: Rate Output & Action Button Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3 border-t border-slate-100">
      
      <div class="space-y-0.5">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Estimated Locked Fare</div>
        <div class="flex items-baseline gap-2">
          <span id="estimator-sgd" class="text-2xl sm:text-3xl font-black text-[#0B2348] leading-none">SGD 85 - 110</span>
          <span class="text-slate-300">/</span>
          <span id="estimator-myr" class="text-sm sm:text-base font-bold text-[#B88A3B]">MYR 280 - 350</span>
        </div>
      </div>

      <a 
        id="estimator-cta"
        href="/contact"
        class="inline-flex items-center justify-center gap-2 bg-[#0B2348] hover:bg-[#163768] text-white font-bold px-6 py-3 rounded-xl text-xs sm:text-sm shadow-sm transition-all duration-200 cursor-pointer select-none"
      >
        <span>Reserve This Trip</span>
        <ArrowRight class="w-4 h-4" />
      </a>

    </div>

    <!-- Bottom Row: Clean Trust Alignment Strip (Zero Wrapping Glitches) -->
    <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-slate-600">
      <div class="flex items-center gap-1.5">
        <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
        <span>Toyota Innova Zenix Guaranteed</span>
      </div>
      <div class="flex items-center gap-1.5">
        <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
        <span>Zero Upfront Deposit</span>
      </div>
      <div class="flex items-center gap-1.5">
        <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
        <span>PayNow & Touch 'n Go Ready</span>
      </div>
    </div>

  </div>
</div>

<script>
  const serviceSelect = document.getElementById('estimator-service') as HTMLSelectElement | null;
  const terminalSelect = document.getElementById('estimator-terminal') as HTMLSelectElement | null;
  const sgdDisplay = document.getElementById('estimator-sgd');
  const myrDisplay = document.getElementById('estimator-myr');
  const ctaButton = document.getElementById('estimator-cta') as HTMLAnchorElement | null;

  function updateEstimator() {
    if (!serviceSelect || !sgdDisplay || !myrDisplay || !ctaButton) return;
    const selectedOption = serviceSelect.options[serviceSelect.selectedIndex];
    const sgd = selectedOption.getAttribute('data-sgd') || 'SGD 85 - 110';
    const myr = selectedOption.getAttribute('data-myr') || 'MYR 280 - 350';
    
    sgdDisplay.textContent = sgd;
    myrDisplay.textContent = myr;

    const terminalVal = terminalSelect ? terminalSelect.value : 'Batam Centre';
    const serviceVal = selectedOption.text;
    ctaButton.href = `/contact?terminal=${encodeURIComponent(terminalVal)}&service=${encodeURIComponent(serviceVal)}`;
  }

  serviceSelect?.addEventListener('change', updateEstimator);
  terminalSelect?.addEventListener('change', updateEstimator);
  updateEstimator();
</script>
