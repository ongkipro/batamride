---
interface Props {
  title?: string;
  description?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  title = "Ready to plan your Batam ride?",
  description = "Complete the booking form, review your details, then choose the official Singapore or Malaysia WhatsApp contact.",
  primaryCtaText = "Reserve Private Driver",
  primaryCtaHref = "/#booking",
  secondaryCtaText = "Contact Dispatch Desk",
  secondaryCtaHref = "/contact/"
} = Astro.props;
---

<section class="landing-cta-section">
  <div class="shell">
    <div class="cta-card">
      <div class="cta-left">
        <div class="cta-status-badge">
          <span class="status-dot"></span>
          <span>Dispatch Active Daily 06:00 – 23:00 SGT</span>
        </div>
        <h2 class="cta-title">{title}</h2>
        <p class="cta-desc">{description}</p>
      </div>

      <div class="cta-actions">
        <a class="button button-gold cta-btn" href={primaryCtaHref}>
          {primaryCtaText}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a class="button button-outline cta-btn-outline" href={secondaryCtaHref}>
          {secondaryCtaText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .landing-cta-section {
    padding: 72px 0 88px;
    background: #ffffff;
  }

  .cta-card {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: 48px;
    padding: 48px 52px;
    background:
      radial-gradient(circle at 90% 20%, rgba(197, 161, 96, 0.18), transparent 45%),
      linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 100%);
    border: 1px solid rgba(197, 161, 96, 0.25);
    border-radius: 28px;
    box-shadow: 0 24px 60px rgba(4, 15, 32, 0.16);
    color: #ffffff;
  }

  .cta-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 16px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
  }

  .cta-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .cta-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    max-width: 580px;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cta-btn {
    width: 100%;
    font-size: 15px;
    min-height: 50px;
  }

  .cta-btn-outline {
    width: 100%;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.06);
    min-height: 50px;
  }

  .cta-btn-outline:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 980px) {
    .cta-card {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 36px 30px;
    }
  }

  @media (max-width: 640px) {
    .landing-cta-section {
      padding: 48px 0 64px;
    }

    .cta-card {
      padding: 28px 20px;
      border-radius: 20px;
    }

    .cta-title {
      font-size: clamp(24px, 6.5vw, 32px);
    }

    .cta-desc {
      font-size: 14.5px;
    }
  }
</style>
