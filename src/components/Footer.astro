---
const currentYear = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<footer class="site-footer">
  <div class="shell footer-main-grid">
    <!-- Col 1: Corporate Profile -->
    <div class="footer-col footer-brand-col">
      <a class="footer-brand" href="/" aria-label="BatamRide Home">
        <img 
          class="brand-logo" 
          src="/assets/batamride-logo.webp" 
          alt="BatamRide — Your Trusted Batam Travel Partner" 
          width="170" 
          height="30"
          loading="lazy"
        />
      </a>
      <p class="footer-desc">
        Premier executive private transport & chauffeur services in Batam Island. Tailored for corporate travelers, golfers, and families arriving from Singapore and Malaysia.
      </p>
      <div class="footer-badges">
        <span class="footer-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Strict Smoke-Free Fleet
        </span>
        <span class="footer-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          Transparent S$70/Day Rates
        </span>
      </div>
    </div>

    <!-- Col 2: Executive Services -->
    <div class="footer-col">
      <h3 class="footer-heading">Executive Services</h3>
      <ul class="footer-links" role="list">
        <li><a href="/batam-private-driver/">Full-Day Private Driver</a></li>
        <li><a href="/batam-ferry-terminal-transfer/">Ferry Terminal Transfer</a></li>
        <li><a href="/batam-airport-transfer/">Airport Transfer (BTH)</a></li>
        <li><a href="/services/">All Chauffeur Services</a></li>
        <li><a href="/singapore-to-batam/">Singapore to Batam Route Guide</a></li>
      </ul>
    </div>

    <!-- Col 3: Company & Fleet -->
    <div class="footer-col">
      <h3 class="footer-heading">Company & Fleet</h3>
      <ul class="footer-links" role="list">
        <li><a href="/about/">About BatamRide</a></li>
        <li><a href="/fleet/">Executive Fleet (Zenix & Reborn)</a></li>
        <li><a href="/faq/">Frequently Asked Questions</a></li>
        <li><a href="/contact/">Corporate Contact & Dispatch</a></li>
        <li><a href="/booking-terms/">Booking Terms & Conditions</a></li>
        <li><a href="/privacy-policy/">Privacy & Data Protection</a></li>
      </ul>
    </div>

    <!-- Col 4: Dispatch Desks & Payment -->
    <div class="footer-col">
      <h3 class="footer-heading">Dispatch & Enquiries</h3>
      <div class="footer-dispatch-card">
        <div class="dispatch-entry">
          <span class="dispatch-label">Singapore Dispatch:</span>
          <a href="https://wa.me/6580900928" target="_blank" rel="noopener noreferrer" class="dispatch-phone">
            <strong>+65 8090 0928</strong>
          </a>
        </div>
        <div class="dispatch-entry">
          <span class="dispatch-label">Malaysia Dispatch:</span>
          <a href="https://wa.me/60189028790" target="_blank" rel="noopener noreferrer" class="dispatch-phone">
            <strong>+60 18-902 8790</strong>
          </a>
        </div>
        <p class="dispatch-hours">Operating daily: 06:00 – 23:00 SGT</p>
      </div>

      <div class="footer-payments">
        <span class="payment-title">Accepted Payment Systems:</span>
        <div class="payment-row">
          <img src="/assets/paynow-logo.webp" alt="PayNow Singapore" width="56" height="20" loading="lazy" />
          <img src="/assets/tng-ewallet-logo.svg" alt="Touch 'n Go eWallet Malaysia" width="40" height="20" loading="lazy" />
          <img src="/assets/visa-logo.svg" alt="Visa International" width="34" height="12" loading="lazy" />
          <img src="/assets/mastercard-logo.jpg" alt="Mastercard International" width="30" height="18" loading="lazy" />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Row -->
  <div class="footer-bottom">
    <div class="shell footer-bottom-inner">
      <p>© {currentYear} BatamRide. All rights reserved. Private passenger transport & corporate chauffeur services in Batam, Riau Islands, Indonesia.</p>
      <div class="footer-bottom-links">
        <a href="/booking-terms/">Terms</a>
        <span class="dot-sep" aria-hidden="true">•</span>
        <a href="/privacy-policy/">Privacy</a>
        <span class="dot-sep" aria-hidden="true">•</span>
        <a href="/contact/">Support</a>
      </div>
    </div>
  </div>
</footer>

{isHome && (
  <>
    <a class="button button-gold mobile-book" href="#booking">Book your ride</a>

    <script>
      // Smart mobile booking floating button visibility
      (() => {
        const mobileBookBtn = document.querySelector(".mobile-book");
        if (!mobileBookBtn) return;

        const handleScroll = () => {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          const hero = document.querySelector(".hero");
          const booking = document.querySelector("#booking");
          const footer = document.querySelector("footer");
          const vh = window.innerHeight;

          const heroBottom = hero ? hero.getBoundingClientRect().bottom : -1;
          const bookingRect = booking ? booking.getBoundingClientRect() : null;
          const inBooking = bookingRect && bookingRect.top < vh - 40 && bookingRect.bottom > 60;

          const footerRect = footer ? footer.getBoundingClientRect() : null;
          const nearFooter = footerRect && footerRect.top < vh - 20;

          // Show only when user has scrolled past hero and is NOT in booking form or touching footer
          if (scrollY > 280 && heroBottom <= 40 && !inBooking && !nearFooter) {
            mobileBookBtn.classList.add("is-visible");
          } else {
            mobileBookBtn.classList.remove("is-visible");
          }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleScroll, { passive: true });
        handleScroll();
      })();
    </script>
  </>
)}
