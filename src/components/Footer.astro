---
import { WHATSAPP_DISPLAY } from '../utils/whatsapp';
---

<footer class="bg-[#071730] text-slate-400 text-xs border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      
      <!-- Col 1: Brand & Tagline -->
      <div class="space-y-4">
        <div class="flex flex-col">
          <span class="text-xl font-black tracking-tight text-white leading-none">
            BATAM<span class="text-[#B88A3B]">RIDE</span>
          </span>
          <span class="text-[9px] font-bold tracking-[0.22em] text-slate-400 uppercase mt-1">
            Private Transport & Tours
          </span>
        </div>
        <p class="text-slate-400 leading-relaxed text-xs">
          Executive private transportation in Batam Island designed for Singapore and Malaysia travelers. Guaranteed white Toyota Innova Zenix MPVs and professional uniformed chauffeurs.
        </p>
        <div class="pt-1 text-slate-300 font-medium space-y-0.5">
          <div class="text-xs">Direct Concierge: <strong class="text-white font-bold">{WHATSAPP_DISPLAY}</strong></div>
          <div class="text-[11px] text-slate-500">Service Hours: 06:00 - 23:00 (WIB)</div>
        </div>
      </div>

      <!-- Col 2: Navigation Directory -->
      <div class="space-y-3">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Explore BatamRide
        </div>
        <ul class="space-y-2 text-slate-300">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">Services & Hourly Charters</a></li>
          <li><a href="/tours" class="hover:text-white transition-colors">Curated Day Tour Packages</a></li>
          <li><a href="/destinations" class="hover:text-white transition-colors">Top Batam Attractions Guide</a></li>
          <li><a href="/fleet" class="hover:text-white transition-colors">Innova Zenix & Chauffeur Standards</a></li>
          <li><a href="/faq" class="hover:text-white transition-colors">Travel Logistics FAQs</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact & Reservation</a></li>
        </ul>
      </div>

      <!-- Col 3: Supported Arrival Ports -->
      <div class="space-y-3">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Arrival Terminals
        </div>
        <ul class="space-y-2 text-slate-400">
          <li>Batam Centre Ferry Terminal</li>
          <li>Harbour Bay Ferry Terminal</li>
          <li>Sekupang Ferry Terminal</li>
          <li>Nongsapura Ferry Terminal</li>
          <li>Hang Nadim International Airport (BTH)</li>
        </ul>
      </div>

      <!-- Col 4: Payment Methods & Reassurance -->
      <div class="space-y-3">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Cross-Border Payments
        </div>
        <p class="text-slate-400 text-xs leading-relaxed">
          Pay conveniently with zero currency exchange headaches on arrival:
        </p>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 text-[11px] font-semibold border border-white/10">PayNow (SG)</span>
          <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 text-[11px] font-semibold border border-white/10">Touch n Go (MY)</span>
          <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 text-[11px] font-semibold border border-white/10">SenangPay</span>
          <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 text-[11px] font-semibold border border-white/10">Visa / Mastercard</span>
          <span class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 text-[11px] font-semibold border border-white/10">IDR Cash</span>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
      <div>
        © {new Date().getFullYear()} BatamRide. All rights reserved. Premium private transport in Batam.
      </div>
      <div class="flex items-center gap-6 text-slate-400">
        <a href="/faq" class="hover:text-white transition-colors">Booking Policies</a>
        <a href="/contact" class="hover:text-white transition-colors">Customer Support</a>
      </div>
    </div>
  </div>
</footer>
