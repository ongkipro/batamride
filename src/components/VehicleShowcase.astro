---
interface Props {
  eyebrow?: string;
  title?: string;
  titleHighlight?: string;
  description?: string;
  features?: Array<{
    title: string;
    description: string;
    badge?: string;
  }>;
}

const {
  eyebrow = "Executive MPV Fleet",
  title = "Toyota Innova Zenix & Reborn",
  titleHighlight = "",
  description = "Experience Batam with late-model, smoke-free executive MPVs. Featuring whisper-quiet cabins, dual-zone tropical air conditioning, and cavernous cargo space for 4+ large suitcases or full sets of golf bags.",
  features = [
    {
      title: "Real Vehicle Photos Confirmed",
      description: "You receive actual photos of your assigned car before paying any deposit.",
      badge: "Zero Bait-and-Switch"
    },
    {
      title: "Strict Smoke-Free Guarantee",
      description: "Zero cigarette or tobacco residue, daily steam sanitization.",
      badge: "100% Odorless Cabin"
    },
    {
      title: "Uniformed, Vetted Chauffeurs",
      description: "English, Mandarin, Teochew, and Hokkien language support.",
      badge: "Multilingual Dispatch"
    }
  ]
} = Astro.props;
---

<section class="vehicle-showcase-section" id="fleet-showcase">
  <div class="shell">
    <div class="showcase-header">
      <div class="header-left">
        <p class="showcase-eyebrow">{eyebrow}</p>
        <h2 class="showcase-title">
          {title} {titleHighlight && <span>{titleHighlight}</span>}
        </h2>
      </div>
      <p class="showcase-lede">
        {description}
      </p>
    </div>

    <!-- Interactive Fleet Visual Stage -->
    <div class="fleet-visual-stage">
      <div class="fleet-display-grid">
        <!-- Main Media Frame -->
        <div class="fleet-media-container">
          <div class="media-tabs" role="tablist" aria-label="Vehicle Models">
            <button class="tab-btn is-active" type="button" role="tab" aria-selected="true" data-fleet-target="zenix">
              <span>Innova Zenix</span>
              <small>Executive Hybrid</small>
            </button>
            <button class="tab-btn" type="button" role="tab" aria-selected="false" data-fleet-target="reborn">
              <span>Innova Reborn</span>
              <small>Premium MPV</small>
            </button>
            <button class="tab-btn" type="button" role="tab" aria-selected="false" data-fleet-target="cabin">
              <span>Cabin Comfort</span>
              <small>Interior View</small>
            </button>
          </div>

          <div class="media-viewport">
            <figure class="media-item is-active" id="view-zenix" data-fleet-view="zenix">
              <img 
                src="/assets/batamride-innova-zenix-hotel.webp" 
                alt="White Toyota Innova Zenix executive chauffeur car in Batam" 
                width="1448" 
                height="1086"
                loading="eager"
                decoding="async"
              />
              <figcaption class="media-caption">
                <span class="caption-tag">Flagship Chauffeur Fleet</span>
                <span class="caption-name">Toyota Innova Zenix (Latest Generation)</span>
              </figcaption>
            </figure>

            <figure class="media-item" id="view-reborn" data-fleet-view="reborn" hidden>
              <img 
                src="/assets/batamride-innova-white-hotel.webp" 
                alt="White Toyota Innova Reborn private transport car in Batam" 
                width="1448" 
                height="1086"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="media-caption">
                <span class="caption-tag">Executive MPV</span>
                <span class="caption-name">Toyota Innova Reborn (Spacious Family Comfort)</span>
              </figcaption>
            </figure>

            <figure class="media-item" id="view-cabin" data-fleet-view="cabin" hidden>
              <img 
                src="/images/zenix-interior.webp" 
                alt="Toyota Innova Zenix luxury smoke-free cabin interior" 
                width="1200" 
                height="800"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="media-caption">
                <span class="caption-tag">Smoke-Free Standard</span>
                <span class="caption-name">Plush Seating & Dual-Zone Tropical AC</span>
              </figcaption>
            </figure>
          </div>

          <!-- Capacity & Spec Badges Strip -->
          <div class="fleet-specs-strip">
            <div class="spec-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Up to 7 Passengers</span>
            </div>
            <div class="spec-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 20h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3V4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/><line x1="12" y1="11" x2="12" y2="15"/></svg>
              <span>4+ Large Luggage / Golf Bags</span>
            </div>
            <div class="spec-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/></svg>
              <span>Dual-Zone Tropical Climate</span>
            </div>
            <div class="spec-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span>Exact Car Photo Pre-Confirmed</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 High-Trust Feature Guarantee Cards -->
    <div class="features-grid">
      {features.map((feature, idx) => (
        <article class="feature-card">
          <div class="feature-card-header">
            <span class="feature-check-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            {feature.badge && <span class="feature-badge">{feature.badge}</span>}
          </div>
          <h3 class="feature-card-title">{feature.title}</h3>
          <p class="feature-card-desc">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .vehicle-showcase-section {
    padding: 84px 0 92px;
    background: #fbfbfd;
    position: relative;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .showcase-header {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .showcase-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--gold);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .showcase-eyebrow::before {
    content: "";
    width: 22px;
    height: 1.5px;
    background: var(--gold);
  }

  .showcase-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 3.6vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy-950);
    margin: 0;
  }

  .showcase-title span {
    font-style: italic;
    color: var(--gold);
  }

  .showcase-lede {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-soft);
  }

  /* Fleet Visual Stage */
  .fleet-visual-stage {
    margin-bottom: 36px;
    border-radius: 24px;
    background: #ffffff;
    border: 1px solid rgba(8, 29, 59, 0.08);
    box-shadow: 0 20px 48px rgba(4, 15, 32, 0.05);
    overflow: hidden;
  }

  .fleet-media-container {
    display: flex;
    flex-direction: column;
  }

  .media-tabs {
    display: flex;
    gap: 2px;
    background: #081d3b;
    padding: 8px 10px;
    overflow-x: auto;
  }

  .tab-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 18px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: rgba(255, 255, 255, 0.72);
    cursor: pointer;
    transition: all 180ms ease;
    white-space: nowrap;
    font-family: inherit;
    text-align: left;
  }

  .tab-btn span {
    font-size: 14px;
    font-weight: 700;
    color: inherit;
    line-height: 1.2;
  }

  .tab-btn small {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 3px;
  }

  .tab-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .tab-btn.is-active {
    background: rgba(197, 161, 96, 0.18);
    border: 1px solid rgba(197, 161, 96, 0.4);
    color: #ffffff;
  }

  .tab-btn.is-active small {
    color: var(--gold-soft);
  }

  .media-viewport {
    position: relative;
    background: #040f20;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 520px;
    overflow: hidden;
  }

  .media-item {
    margin: 0;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 300ms ease;
  }

  .media-item.is-active {
    opacity: 1;
    visibility: visible;
  }

  .media-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .media-caption {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    background: rgba(4, 15, 32, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    color: #ffffff;
  }

  .caption-tag {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(197, 161, 96, 0.22);
    border: 1px solid rgba(197, 161, 96, 0.4);
    border-radius: 999px;
    color: var(--gold-soft);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .caption-name {
    font-size: 14px;
    font-weight: 650;
    color: #ffffff;
  }

  .fleet-specs-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 12px 20px;
    padding: 16px 24px;
    background: #f8fafc;
    border-top: 1px solid var(--line);
  }

  .spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 650;
    color: var(--navy-900);
  }

  .spec-pill svg {
    color: var(--gold);
    flex-shrink: 0;
  }

  /* 3 Features Cards */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    padding: 30px 26px;
    background: #ffffff;
    border: 1px solid rgba(8, 29, 59, 0.09);
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(4, 15, 32, 0.03);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    display: flex;
    flex-direction: column;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(4, 15, 32, 0.08);
    border-color: rgba(197, 161, 96, 0.35);
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .feature-check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(197, 161, 96, 0.14);
    border: 1px solid rgba(197, 161, 96, 0.35);
    color: var(--gold-deep);
    flex-shrink: 0;
  }

  .feature-badge {
    display: inline-block;
    padding: 3px 8px;
    background: #f1f5f9;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: var(--navy-800);
  }

  .feature-card-title {
    font-size: 18.5px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--navy-950);
    margin: 0 0 10px;
    letter-spacing: -0.015em;
  }

  .feature-card-desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-soft);
  }

  /* Responsive Adjustments */
  @media (max-width: 980px) {
    .showcase-header {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .fleet-specs-strip {
      justify-content: flex-start;
      gap: 12px 18px;
      padding: 14px 18px;
    }
  }

  @media (max-width: 640px) {
    .vehicle-showcase-section {
      padding: 60px 0 68px;
    }

    .showcase-title {
      font-size: clamp(28px, 7vw, 36px);
    }

    .media-viewport {
      aspect-ratio: 4 / 3;
    }

    .caption-name {
      display: none;
    }

    .feature-card {
      padding: 24px 20px;
    }
  }
</style>

<script>
  function setupFleetTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn[data-fleet-target]');
    const views = document.querySelectorAll<HTMLElement>('.media-item[data-fleet-view]');
    if (!tabs.length || !views.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-fleet-target');
        if (!target) return;

        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        views.forEach((view) => {
          if (view.getAttribute('data-fleet-view') === target) {
            view.classList.add('is-active');
            view.removeAttribute('hidden');
          } else {
            view.classList.remove('is-active');
            view.setAttribute('hidden', '');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFleetTabs);
  } else {
    setupFleetTabs();
  }
</script>
