---
import Breadcrumb, { type BreadcrumbItem } from './Breadcrumb.astro';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  breadcrumbItems?: BreadcrumbItem[];
  bgImage?: string;
}

const {
  badge,
  title,
  subtitle,
  breadcrumbItems = [],
  bgImage = '/images/hero-zenix.jpg'
} = Astro.props;
---

<!-- Clean, Minimalist Sub-Page Header (Mobile Web App Style) -->
<div class="relative bg-[#051326] text-white py-12 sm:py-16 overflow-hidden">
  
  <!-- Subtle Background Image with Clean Dark Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={bgImage} 
      alt={title} 
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#051326]/95 via-[#051326]/85 to-[#051326]/75"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#051326] via-transparent to-black/30"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-3 z-10">
    
    <!-- Semantic Breadcrumb Navigation -->
    {breadcrumbItems.length > 0 && (
      <div class="mb-2">
        <Breadcrumb items={breadcrumbItems} />
      </div>
    )}

    <div class="max-w-3xl space-y-2">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-wider text-[#D2AD68] block">
          {badge}
        </span>
      )}

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        {title}
      </h1>

      {subtitle && (
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-2xl pt-0.5">
          {subtitle}
        </p>
      )}
    </div>

  </div>
</div>
